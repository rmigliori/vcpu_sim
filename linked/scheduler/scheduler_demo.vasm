; linked/scheduler/scheduler_demo.vasm — DEMO dello scheduler round-robin preemptivo.
;
; Contiene SOLO codice applicativo: boot (main), due task, l'handler del timer e
; i dati dell'applicazione. Il software di base sta sotto:
;   hal/machine.vasm       -> HAL: vettore di trap, save/restore, timer (l'hw).
;   kernel/coda.vasm       -> le 5 routine di coda (list_head).
;   kernel/scheduler.vasm  -> kernel puro: politica RR + dispatch (nessun CSR).
;
; Pipeline (compilazione separata + linking, path relativi a linked/scheduler/):
;   ./build/vcpu_sim asm -Iinclude hal/machine.vasm   -o build/machine.vo
;   ./build/vcpu_sim asm -Iinclude kernel/coda.vasm   -o build/coda.vo
;   ./build/vcpu_sim asm -Iinclude kernel/scheduler.vasm    -o build/scheduler.vo
;   ./build/vcpu_sim asm -Iinclude scheduler_demo.vasm      -o build/scheduler_demo.vo
;   ./build/vcpu_sim ld build/scheduler_demo.vo build/scheduler.vo build/coda.vo \
;                       build/machine.vo -o build/scheduler_demo.vx
;   ./build/vcpu_sim run build/scheduler_demo.vx   (aggiungi --trace per vederlo)
;
; Due task incrementano ciascuno il proprio contatore in un loop infinito; dopo
; 8 tick l'handler ferma il sistema e stampa i due contatori: entrambi cresciuti
; e vicini => i task si sono alternati (round-robin).

; Tipi comuni (TCB, stati) condivisi col kernel: stessa sorgente di verita'.
.include "tcb.vinc"

  .data

tickA:  .word 0        ; contatore applicativo di A (FUORI dal TCB)
tickB:  .word 0        ; contatore applicativo di B
ticks:  .word 0        ; numero di tick timer avvenuti (lo tiene l'handler)

tcbA:   .res TCB       ; TCB task A
tcbB:   .res TCB       ; TCB task B

stackA: .space 64      ; stack task A (256 byte)
stackA_top:
stackB: .space 64      ; stack task B
stackB_top:

  .text

  .global main
  .extern ready
  .extern current
  .extern coda_init
  .extern enqueue_coda
  .extern irq_install
  .extern request_preempt
  .extern sched_isr_exit
  .extern ctx_init
  .extern timer_init
  .extern irq_arm
  .extern irq_enable

; ==========================================================================
;  BOOT: costruisce le strutture, registra l'handler, arma il timer e LANCIA il
;  primo task saltando al suo entry (jr, a freddo). main non e' un task: non ha
;  TCB e non torna mai. Il primo task parte con registri 0 e stack vuoto; solo i
;  task che RIPARTONO dopo una preemption passano dal dispatcher (reti).
; ==========================================================================
main:
  li r1, ready
  call coda_init           ; ready queue vuota

  ; --- priming del contesto iniziale di B (frame finto costruito dall'HAL) ---
  li r1, stackB_top
  li r2, taskB
  call ctx_init            ; r1 = sp iniziale di B (riparte via reti al 1o switch)
  li r3, tcbB
  sw r1, TCB.sp(r3)        ; tcbB.sp = contesto iniziale
  sw r0, TCB.state(r3)     ; stato = READY
  li r1, ready
  li r2, tcbB
  call enqueue_coda        ; B pronto in coda

  ; --- A e' il primo a girare: RUNNING, puntato da current, FUORI dalla coda ---
  li r1, current
  li r2, tcbA
  sw r2, 0(r1)             ; current = A
  li r5, RUNNING
  sw r5, TCB.state(r2)     ; tcbA.stato = RUNNING

  li r1, timer_isr
  call irq_install         ; registra l'ISR applicativa NELL'HAL: il vettore le
                           ; consegnera' il controllo direttamente (§12.2)
  call irq_arm             ; installa il vettore di trap dell'HAL
  li r1, 500
  call timer_init          ; un tick ogni 500 cicli
  li r14, stackA_top       ; sp di A pronto prima di abilitare i trap
  call irq_enable          ; abilita gli interrupt
  li r5, taskA
  jr r5                    ; cold start di A: primo task a freddo, senza reti

; ==========================================================================
;  I due task: loop infinito che incrementa il proprio contatore.
;  r1,r2 sono privati di ciascun task: il context switch li preserva.
; ==========================================================================
taskA:
  li r1, tickA
loopA:
  lw r2, 0(r1)
  addi r2, r2, 1
  sw r2, 0(r1)
  j loopA

taskB:
  li r1, tickB
loopB:
  lw r2, 0(r1)
  addi r2, r2, 1
  sw r2, 0(r1)
  j loopB

; ==========================================================================
;  timer_isr(r1 = contesto opaco del task interrotto): ISR APPLICATIVA del
;  timer, registrata nell'HAL con irq_install. Ci arriva direttamente il vettore
;  di trap: l'HAL ha gia' salvato il contesto e non fa altro, quindi da qui in
;  poi decide l'applicazione (§12.2 della proposta).
;
;  NON RITORNA: un'ISR sceglie come uscire, e non c'e' nessuno a cui tornare
;  (il vettore ha consegnato con `jr`). Qui l'uscita e' sempre la stessa —
;  salta a sched_isr_exit passando il contesto — ma e' una scelta di QUESTA
;  ISR, non una regola: §12.4 ne elenca tre.
;
;  Il contesto arriva in r1, che serve subito come scratch: va messo al sicuro
;  in un registro che sopravviva alle call (r6). Il kernel se lo aspetta in r1
;  all'uscita, perche' e' lui a doverlo registrare nel TCB — non l'ISR, che del
;  TCB non sa niente.
;
;  Conta i tick; dopo 8 stampa i contatori e ferma; altrimenti chiede lo switch.
; ==========================================================================
timer_isr:
  mov r6, r1              ; il contesto: r1 sta per essere sporcato
  li r1, ticks
  lw r2, 0(r1)
  addi r2, r2, 1
  sw r2, 0(r1)
  li r3, 8                ; ferma dopo 8 tick
  blt r2, r3, isr_go
  li r1, tickA            ; stop: stampa i due contatori e termina
  lw r5, 0(r1)
  dumps r5
  li r1, tickB
  lw r5, 0(r1)
  dumps r5
  halt
isr_go:
  call request_preempt    ; chiede lo switch a uscita IRQ (need_resched)
  mov r1, r6              ; il contesto torna in r1, dove il kernel lo aspetta
  j sched_isr_exit        ; uscita dall'ISR: da qui decide il kernel
