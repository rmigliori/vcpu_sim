; hal/machine.vasm — HAL (Hardware Abstraction Layer): l'UNICO codice che tocca
; l'hardware di questa macchina. Isola il kernel dai dettagli della CPU e del
; timer, cosi' il kernel resta puro (politica + code, nessun CSR).
;
; E' lo strato "port/arch" dei kernel reali: FreeRTOS portable/portASM, Linux
; arch/*/entry.S. Sa: file dei registri, layout del frame di contesto, i CSR
; delle eccezioni (mfepc/mtepc/reti), il vettore di trap, il timer. NON sa nulla
; di ready queue, TCB, current, handler o politica di scheduling.
;
; Contratto col kernel: il contesto salvato di un task e' OPACO. L'HAL lo salva
; sullo stack, ne passa il puntatore (sp) al kernel e riceve indietro il
; puntatore del contesto da riprendere. Il kernel non interpreta mai il frame.
;
; --- Frame di contesto (sullo stack del task, sp = r14, CTX_FRAME_SIZE byte) ---
;   Push, in quest'ordine: r15(ra) [da _trap_entry, raw], poi r1..r13, poi psw e
;   epc [da ctx_save] -> epc finisce in cima (indirizzo piu' basso). r14(sp) NON
;   e' nel frame: e' il puntatore-a-contesto stesso. I registri VETTORIALI (v*,
;   vl, vmask) sono VOLATILI attraverso la preemption (la trap arriva solo al
;   confine d'istruzione: nessuna corsia viva da salvare). Il layout resta
;   privato dell'HAL: il kernel vede solo un puntatore opaco. La taglia sta in
;   hal.vinc, perche' chi costruisce un frame senza passare da ctx_init non deve
;   riscriverla a mano.
;
;   LA PAROLA DI STATO E' NEL FRAME dal 05/09/2026 (§12.5 della proposta).
;   Prima non c'era, e il commento qui diceva perche': "epsw non e' scrivibile e
;   IE=1 e' uniforme (la trap mette IE=0, reti lo riporta a 1)". Quell'uniformita'
;   valeva finche' si torna SEMPRE a un task. Non vale piu' nel momento in cui il
;   ritorno puo' puntare a codice di kernel, che si troverebbe a girare con gli
;   interrupt aperti: da li' `mfepsw`/`mtepsw` nell'ISA e questa parola nel frame.

.include "hal.vinc"

  .data

; Il vettore applicativo, registrato con irq_install. Sta QUI e non nel kernel
; (dove stava fino al 05/09/2026) perche' installare un vettore e' hardware, e
; perche' e' questo che rompe la dipendenza HAL -> kernel: l'HAL consegna il
; controllo a un puntatore, non a un nome. Vedi §12.2 della proposta.
g_handler: .word 0        ; puntatore all'ISR applicativa (indice istruzione)

  .text

  .global _trap_entry
  .global ctx_restore
  .global ctx_init
  .global timer_init
  .global irq_arm
  .global irq_install
  .global irq_enable
  .global irq_save
  .global irq_restore

; ==========================================================================
;  _trap_entry: VETTORE di trap del timer. All'ingresso r14 = sp del task
;  interrotto, IE=0, epc = pc dell'istruzione interrotta, r1..r15 sono ancora
;  live (il task interrotto ce li teneva). Salva il contesto e CONSEGNA IL
;  CONTROLLO ALL'ISR APPLICATIVA, con r1 = contesto opaco.
;
;  L'HAL finisce qui: non sa cosa fara' l'ISR, e non nomina un solo simbolo di
;  kernel. E' l'ISR — codice applicativo — a essere cliente sia dell'HAL sia del
;  kernel, e a decidere come si esce (§12.4: all'istruzione interrotta, allo
;  scheduler, o al dispatcher). Fino al 05/09/2026 qui c'era invece una
;  `call sched_dispatch`: il kernel stava IN MEZZO fra il vettore e l'ISR, e da
;  li' veniva il ciclo hal -> kernel -> hal (§12.1).
;
;  `jr` e non `jalr`: l'ISR non torna qui. Il vettore consegna e sparisce.
;
;  Il push raw di r15 qui sotto e' l'UNICA istruzione dell'intero HAL che deve
;  restare a mano invece di stare dentro ctx_save: "call" e' sempre "jal r15,
;  target" (r15 cablato come link register, vedi assembler), quindi qualunque
;  call fatta prima di aver salvato r15 lo distruggerebbe mentre contiene
;  ancora il valore live del task interrotto. Va salvato per primo, senza call.
; ==========================================================================
_trap_entry:
  addi r14, r14, -4
  sw r15, 0(r14)          ; DEVE precedere ogni call: vedi nota sopra
  call ctx_save           ; HAL: salva r1..r13 + psw + epc; r1 = contesto opaco
  li r5, g_handler
  lw r5, 0(r5)
  jr r5                   ; consegna all'ISR applicativa (r1 = contesto)

; ==========================================================================
;  ctx_save: seconda meta' del salvataggio contesto (la prima e' il push raw di
;  r15 in _trap_entry, sopra). FOGLIA: non chiama nulla, quindi non tocca mai
;  r15 -> nessun salvataggio necessario per se stessa. Ritorna r1 = puntatore
;  al contesto opaco (la cima dell'intero frame).
; ==========================================================================
ctx_save:
  addi r14, r14, -4
  sw r1, 0(r14)
  addi r14, r14, -4
  sw r2, 0(r14)
  addi r14, r14, -4
  sw r3, 0(r14)
  addi r14, r14, -4
  sw r4, 0(r14)
  addi r14, r14, -4
  sw r5, 0(r14)
  addi r14, r14, -4
  sw r6, 0(r14)
  addi r14, r14, -4
  sw r7, 0(r14)
  addi r14, r14, -4
  sw r8, 0(r14)
  addi r14, r14, -4
  sw r9, 0(r14)
  addi r14, r14, -4
  sw r10, 0(r14)
  addi r14, r14, -4
  sw r11, 0(r14)
  addi r14, r14, -4
  sw r12, 0(r14)
  addi r14, r14, -4
  sw r13, 0(r14)
  mfepsw r1               ; r1 e' gia' in memoria: libero come scratch
  addi r14, r14, -4
  sw r1, 0(r14)           ; psw del task (IE=1: girava abilitato)
  mfepc r1
  addi r14, r14, -4
  sw r1, 0(r14)           ; epc in cima al frame
  mov r1, r14             ; r1 = puntatore al contesto opaco (per il chiamante)
  ret

; ==========================================================================
;  ctx_restore(r1 = puntatore al contesto da riprendere): ripristina i
;  registri e cede il controllo con reti. Speculare a ctx_save + al push raw
;  di r15 in _trap_entry. Non ritorna mai (nessun salvataggio di r15 propria).
; ==========================================================================
ctx_restore:
  mov r14, r1
  lw r1, 0(r14)           ; epc dal frame
  addi r14, r14, 4
  mtepc r1
  lw r1, 0(r14)           ; psw dal frame: il regime in cui il task riprende
  addi r14, r14, 4
  mtepsw r1
  lw r13, 0(r14)
  addi r14, r14, 4
  lw r12, 0(r14)
  addi r14, r14, 4
  lw r11, 0(r14)
  addi r14, r14, 4
  lw r10, 0(r14)
  addi r14, r14, 4
  lw r9, 0(r14)
  addi r14, r14, 4
  lw r8, 0(r14)
  addi r14, r14, 4
  lw r7, 0(r14)
  addi r14, r14, 4
  lw r6, 0(r14)
  addi r14, r14, 4
  lw r5, 0(r14)
  addi r14, r14, 4
  lw r4, 0(r14)
  addi r14, r14, 4
  lw r3, 0(r14)
  addi r14, r14, 4
  lw r2, 0(r14)
  addi r14, r14, 4
  lw r1, 0(r14)
  addi r14, r14, 4
  lw r15, 0(r14)
  addi r14, r14, 4
  reti                    ; pc = epc; psw = quella del frame -> il task riparte

; ==========================================================================
;  ctx_init(r1 = cima dello stack, r2 = entry del task) -> r1 = sp iniziale.
;  Clobber: r3.
;  Costruisce un frame FINTO col layout di _trap_entry: epc = entry, psw con
;  IE=1, i registri restano 0 (lo stack e' memoria azzerata). Al primo switch-in
;  il task parte via reti come se fosse stato preemptato. E'
;  pxPortInitialiseStack di FreeRTOS.
;
;  LA psw VA SCRITTA ESPLICITAMENTE, e non e' un dettaglio: da quando
;  ctx_restore la ripristina dal frame (mtepsw), uno slot lasciato a zero
;  farebbe partire il task con IE=0 — e un task che gira a interrupt disabilitati
;  non viene mai preemptato. Prima non serviva perche' il regime era uniforme e
;  arrivava dalla epsw lasciata dalla trap precedente.
; ==========================================================================
ctx_init:
  addi r1, r1, -CTX_FRAME_SIZE  ; base del frame (offset 0 = slot epc)
  sw r2, 0(r1)            ; epc = entry
  li r3, PSW_IE
  sw r3, 4(r1)            ; psw = IE:1, il task parte interrompibile
  ret

; ==========================================================================
;  Primitivi hardware del timer e degli interrupt, per il boot del sistema.
; ==========================================================================
timer_init:               ; timer_init(r1 = periodo in cicli): arma il tick
  settimer r1
  ret

irq_arm:                  ; installa il vettore di trap dell'HAL
  sethandler _trap_entry
  ret

; irq_install(r1 = puntatore all'ISR applicativa): la registra. L'app lo ottiene
; con `li rX, la_mia_isr` (R_ADDR -> indice d'istruzione = puntatore a funzione).
; Clobber: r2.
irq_install:
  li r2, g_handler
  sw r1, 0(r2)
  ret

irq_enable:               ; abilita gli interrupt (IE = 1)
  sti
  ret

; ==========================================================================
;  Sezione critica su monoprocessore = disabilitare gli interrupt. Coppia
;  SAVE/RESTORE (non cli/sti secco) per COMPONIBILITA': ripristina lo stato
;  PRECEDENTE, quindi resta corretta anche annidata o con IE gia' 0. La parola
;  di stato viaggia in r5: l'HAL non tocca r1/r2, cosi' un wrapper puo'
;  racchiudere una raw di coda senza disturbarne gli argomenti.
; ==========================================================================
irq_save:                 ; irq_save() -> r5 = psw precedente; poi IE = 0
  mfpsw r5
  cli
  ret

irq_restore:              ; irq_restore(r5 = psw da ripristinare)
  mtpsw r5
  ret
