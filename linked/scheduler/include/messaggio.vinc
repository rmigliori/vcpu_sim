; include/messaggio.vinc — il messaggio e la testa comune del payload.
;
; Interfaccia CONDIVISA fra chi manda e chi riceve, non del kernel:
; kernel/messageHandling.vasm sa muovere i messaggi ma non ne legge un byte
; (§8.4). Include coda.vinc perche' un messaggio E' un nodo di lista e una
; mailbox E' una TESTA.
;
; Nato il 05/09/2026 spezzando types.vinc (§12.6, passo 4).

.include "coda.vinc"

; Messaggio: per il kernel e' SOLO un nodo di coda. Due link, e da +8 in poi il
; payload — che il kernel non legge e non scrive MAI: comporlo correttamente e'
; compito di chi lo manda, interpretarlo di chi lo riceve.
;
; payload e' un indirizzo, non un campo: l'array parte sempre da payload[0] e la
; sua lunghezza la decide chi compone il messaggio. Ne segue che MESSAGGIO.size
; NON e' la dimensione di un messaggio e ".res MESSAGGIO" non va usata: si
; riserva lo spazio che serve, oppure si dichiara una .struct propria che comincia
; con fwd/bwd (stesso idioma con cui TCB ridichiara i due link invece di
; annidare TESTA).
.struct MESSAGGIO
  .field fwd              ; +0  link (idioma list_head, come TESTA e TCB)
  .field bwd              ; +4
  .field payload          ; +8  payload[0]: primo byte del contenuto
.ends

; Testa comune del payload: convenzione fra clienti e fornitori di servizi, NON
; del kernel — kernel/messageHandling.vasm non ne legge un byte. Si sovrappone a
; MESSAGGIO.payload, e da +20 in poi ci sono le specifiche della singola
; richiesta, che pubblica il fornitore nel proprio .vinc insieme alla .size con
; cui il cliente dimensiona il buffer: il MAGGIORE fra specifiche di richiesta e
; di risposta, perche' la risposta e' lo stesso buffer girato (il fornitore
; capovolge messageType, scrive il codice di esito e lo rispedisce a
; replyMailbox, con clientTag gia' al posto giusto). Nessuna allocazione.
;
; Terza sovrapposizione dopo TESTA sul nodo e MESSAGGIO sul buffer: ogni livello
; ha una coda a lunghezza libera che e' il livello sotto, e ognuno e' pubblicato
; dove sta la conoscenza che serve a leggerlo.
.struct PAYLOAD
  .field pool             ; +0  PROVENIENZA del buffer: taglia in byte dell'area
                          ;     dati se viene dal pool, 0 se e' un buffer statico
                          ;     del cliente. La parola NON e' nostra: e'
                          ;     BLOCCO.pool, che il pool scrive a pool_init sulla
                          ;     terza parola di ogni blocco senza sapere che
                          ;     esistano i messaggi. Questo formato le da' un
                          ;     nome e comincia il proprio contenuto dopo, a +4
                          ;     del payload — e' il formato che si adatta al
                          ;     pool, mai il contrario, ed e' cosi' che il pool
                          ;     resta sollevabile in un progetto che di messaggi
                          ;     non ne ha. Sta qui e non in MESSAGGIO perche' il
                          ;     kernel non deve possedere niente dentro il
                          ;     messaggio (§8.4). E sta nella testa
                          ;     COMUNE, non solo sui buffer del pool, perche' una
                          ;     mailbox riceve entrambi i tipi — il messaggio di
                          ;     scadenza viene dal pool, la risposta a una
                          ;     richiesta e' il buffer statico del cliente girato
                          ;     — e con due layout diversi il ricevente non
                          ;     saprebbe nemmeno dove leggere messageType. I
                          ;     buffer statici portano 0 gratis: il .data nasce
                          ;     azzerato.
  .field messageType      ; +4  MSG_REQUEST/MSG_REPLY: la direzione. Serve perche'
                          ;     anche una richiesta in arrivo porta un clientTag,
                          ;     scelto pero' nello spazio di chi l'ha mandata:
                          ;     senza questo campo non si distingue "e' uno dei
                          ;     miei" da "e' di un altro". Divide in due, per
                          ;     costruzione, lo spazio dei codici della mailbox.
  .field clientTag        ; +8  parola OPACA scelta dal cliente; il fornitore la
                          ;     ricopia identica nella risposta e non la legge
                          ;     mai. Correla richiesta e risposta anche con piu'
                          ;     richieste in volo; il cliente ci mette quel che
                          ;     vuole, tipicamente il puntatore al proprio
                          ;     contesto di attesa, cosi' al ritorno non cerca
                          ;     niente.
  .field messageCode      ; +12 codice della richiesta. Nella risposta e' un
                          ;     codice di ESITO, di uno spazio diverso, cosi' una
                          ;     richiesta puo' avere piu' esiti senza infilarli
                          ;     nelle specifiche. INVARIANTE: una risposta si
                          ;     smista su clientTag, MAI sul codice — smistare sul
                          ;     codice funziona con un fornitore solo e si rompe
                          ;     al secondo.
  .field replyMailbox     ; +16 mailbox del cliente, che essendone una per task
                          ;     E' la sua identita': nessun campo di identita' in
                          ;     piu'. E' anche cio' che rende scrivibile UNA sola
                          ;     volta la routine generica di risposta.
  .field specifiche       ; +20 specifiche[0]: primo byte, lunghezza dal fornitore
.ends

; Un PAYLOAD senza specifiche occupa 20 byte, di cui i primi 4 sono la parola
; del pool: sedici byte di area dati, cioe' esattamente la classe piu' piccola
; del pool (POOL_D16). E' un'osservazione di questo file e non di pool.vinc — le
; classi sono potenze di due per conto loro — e vale la pena scriverla perche' e'
; il buffer che manda il gestore dei timeout quando un descrittore scade.

.equ MSG_REQUEST 0
.equ MSG_REPLY   1
