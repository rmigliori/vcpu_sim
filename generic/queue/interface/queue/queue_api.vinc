; queue/queue_api.vinc — INTERFACCIA DI CHIAMATA di generic/queue: le entry e il
; contratto con cui si chiamano. I tipi stanno accanto, in queue.vinc, ed e'
; questo file a includerli: un cliente ne include UNO SOLO e ha tutto.
;
; Nato il 07/09/2026. Prima gli .extern se li scriveva ogni cliente a mano, e
; l'interfaccia pubblicava i tipi ma non le procedure: per sapere che
; enqueue_tail vuole la testa in r1 e restituisce l'esito in r3 bisognava aprire
; l'implementazione. §8.6 della proposta lo chiedeva gia' ("gli indirizzi delle
; entry se e' un'API"); hal.vinc scriveva la regola opposta ("qui ci sono solo
; costanti"), ed e' quella che cede.
;
; --- PERCHE' DUE FILE E NON UNO ---
; Un .vinc unico non e' scrivibile, e non per gusto: il fornitore include la
; propria interfaccia per gli offset di HEAD, e un .extern di un simbolo che lo
; stesso modulo dichiara .global e' un errore secco dell'assembler
; ("'enqueue_tail' is both defined and .extern"). Quindi:
;
;   queue.vinc      i TIPI            lo include il FORNITORE (queue.vasm) e gli
;                                    altri header i cui nodi sono liste —
;                                    tcb.vinc, message.vinc, pool.vinc:
;                                    vogliono HEAD, non le procedure
;   queue_api.vinc  i TIPI + le ENTRY lo include CHI CHIAMA
;
; Ne discendono due regole, e la seconda serve a rendere la prima impossibile da
; violare per sbaglio:
;
;   1. un modulo include il .vinc dei TIPI del proprio fornitore e l'_api DEGLI
;      ALTRI. Mai il proprio _api;
;   2. un _api include solo i tipi del proprio modulo, mai l'_api di un altro.
;      Senza la (2) un _api potrebbe rimettere in circolo, per via indiretta,
;      quello di chi sta compilando — e il messaggio d'errore non dice da quale
;      catena di .include arriva.
;
; La (2) ha un effetto voluto: la lista degli .include di un modulo torna a
; essere la sua lista di dipendenze, leggibile a colpo d'occhio. E' il ruolo che
; prima avevano gli .extern scritti a mano in cima a ogni sorgente, e che
; sarebbe andato perso spostandoli qui dentro se gli _api si concatenassero.

.include "queue/queue.vinc"

; --------------------------------------------------------------------------
;  CONVENZIONE DEI REGISTRI
;
;  r1, r2 argomenti; r3 esito (CODA_*); r4, r5, r6 scratch.
;
;  Le RAW e le _nc sono FOGLIA: non toccano r14 (sp) ne' r15 (ra), quindi sono
;  chiamabili anche dentro un'ISR. I wrapper _s NON sono foglia — usano stack e
;  r15 — e in piu' sporcano r5, che e' dove irq_save consegna la psw.
;
;  dequeue_head e dequeue_head_nc NON restituiscono un CODA_*: la coda vuota
;  non e' un errore ma un esito normale, e il valore di ritorno e' il nodo
;  (0 = vuota). r3 arriva intatto al chiamante.
;
;  Le tre discipline — contate, _nc (contatore al chiamante), _s (protette) —
;  e la regola "una sola disciplina per testa" stanno in cima a queue.vasm, che
;  e' il posto dove si spiegano; qui c'e' come si chiamano.
; --------------------------------------------------------------------------

; --- CONTATE: sulla loro testa count >= 0 = numero di nodi ---
  .extern queue_init         ; (r1=&head)                       sporca: niente
  .extern enqueue_tail      ; (r1=&head, r2=&node) -> r3 esito  sporca: r3 r4 r5
  .extern enqueue_head     ; (r1=&head, r2=&node) -> r3 esito  sporca: r3 r4 r5
  .extern dequeue_head     ; (r1=&head) -> r2 nodo, 0 se vuota sporca: r2 r4 r5
  .extern remove_buffer     ; (r1=&node, r2=&head) -> r3 esito  sporca: r3 r4 r5 r6

; --- NON CONTATE: i link e basta, la contabilita' e' del chiamante ---
  .extern enqueue_tail_nc   ; (r1=&head, r2=&node) -> r3 esito  sporca: r3 r4
  .extern enqueue_head_nc  ; (r1=&head, r2=&node) -> r3 esito  sporca: r3 r4
  .extern enqueue_after_nc   ; (r1=&prev,  r2=&node) -> r3 esito  sporca: r3 r4
  .extern dequeue_head_nc  ; (r1=&head) -> r2 nodo, 0 se vuota sporca: r2 r4
  .extern remove_buffer_nc  ; (r1=&node)            -> r3 esito  sporca: r3 r4 r5

; --- SCANSIONE: guarda e non tocca. Fuori dai due assi dei suffissi ---
; Non e' _nc (il contatore non lo tocca nessuno: legge e basta) e non avra' una
; _s (la sezione critica deve comprendere tutta la camminata, §13.6).
;
; Chiamata con r1 = &testa restituisce il primo nodo; rimettendole dentro cio'
; che ha restituito si avanza di uno. NON segnala la fine del giro: quante volte
; chiamarla lo sa il chiamante, che e' il proprietario del contatore (§8.3). Un
; ciclo limitato da un conteggio non scappa nemmeno su una lista corrotta, ed e'
; il limite che §13.6 chiede di dichiarare invece di lasciare implicito.
  .extern queue_peek         ; (r1=&current) -> r2 successore   sporca: r2

; --- PROTETTE: la raw dentro irq_save/irq_restore, per l'uso da TASK (IE=1) ---
; Non foglia, e sporcano r5 oltre a cio' che sporca la raw corrispondente.
  .extern enqueue_tail_s    ; (r1=&head, r2=&node) -> r3 esito
  .extern enqueue_head_s   ; (r1=&head, r2=&node) -> r3 esito
  .extern dequeue_head_s   ; (r1=&head) -> r2 nodo, 0 se vuota
  .extern remove_buffer_s   ; (r1=&node, r2=&head) -> r3 esito
