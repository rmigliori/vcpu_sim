; include/pool.vinc — interfaccia del pool di buffer (§10 della proposta).
;
; Allocazione STATICA, non dinamica. Quello che i requisiti di safety escludono
; non e' "prendere un buffer a runtime", e' lo heap general-purpose: taglia
; variabile da un'arena comune, che frammenta, non ha un tempo di risposta
; limitabile e fallisce in funzione della STORIA delle allocazioni precedenti.
; Qui niente di tutto questo, per una proprieta' sola: DENTRO UNA CLASSE TUTTI I
; BLOCCHI SONO INTERCAMBIABILI. Da li' discende che non esiste frammentazione
; (non esiste "il blocco sbagliato"), che alloc e free sono un dequeue e un
; enqueue quindi O(1), e che il fallimento e' una condizione sola e limitata.
;
; INCLUDE queue.vinc, ed e' una dipendenza vera e non una comodita': BLOCCO *e'*
; un nodo di lista (fwd/bwd in testa, stesso idioma list_head), e una free-list
; e' una TESTA con i blocchi come nodi. Chi usa il pool usa le code.
;
; Scrivibile solo da quando `.include` e' idempotente: prima, un .vinc che ne
; includesse un altro esplodeva con "duplicate constant" appena un chiamante
; includeva entrambi — ed e' esattamente il caso di pool.vasm e test_pool.vasm.
; Il nome e' qualificato con la cartella della libreria e si risolve SOLO via
; -I: .include cerca nella cartella del file di PRIMO LIVELLO, mai in quella di
; chi include, quindi un modulo che non ha dichiarato l'interfaccia delle code
; non lo trova e non assembla. E' il vincolo che la ristrutturazione del
; 06/09/2026 e' venuta a costruire.
.include "queue/queue.vinc"

; --------------------------------------------------------------------------
;  Le sei classi, per potenze di due sull'AREA DATI UTENTE.
;
;  La geometria e' interfaccia e non cambia piu'; quanti blocchi per classe e'
;  dimensionamento del singolo sistema, e lo zero e' legale (costa una TESTA
;  vuota). NIENTE RIPIEGO sulla classe superiore: servire una richiesta da 16 con
;  un blocco da 32 renderebbe il fallimento dipendente dalla storia — una raffica
;  di richieste piccole si mangia la lista grande e piu' tardi fallisce una
;  richiesta da 512 che aveva il suo blocco garantito per costruzione.
;
;  Le sei taglie sono potenze di due e non hanno bisogno di altra motivazione:
;  che una certa classe capiti giusta per un certo formato e' un'osservazione
;  che appartiene a quel formato, e sta scritta li'.
; --------------------------------------------------------------------------
.equ POOL_D16   16
.equ POOL_D32   32
.equ POOL_D64   64
.equ POOL_D128  128
.equ POOL_D256  256
.equ POOL_D512  512

; --------------------------------------------------------------------------
;  Il blocco, visto dal pool. Nessun campo prima dei link: l'indirizzo
;  consegnato al cliente E' la base dell'allocazione, quindi niente offset
;  negativi e la regola di queue.vasm ("il puntatore al link e' il puntatore al
;  buffer") vale sia quando il blocco e' accodato da qualche parte sia quando
;  sta nella free-list, che lo lincia attraverso quegli stessi due campi.
;
;  Dodici byte di testa, POSSEDUTI DAL POOL, e da +12 un'area che il pool non
;  legge e non scrive mai. Cosa ci metta il cliente — un messaggio, una
;  struttura sua, dei byte — qui non si sa e non si deve sapere: e' la ragione
;  per cui questo modulo dipende dalle sole code e vive senza scheduler e senza
;  formato di messaggio.
;
;  Ne segue un vincolo, ed e' a carico di chi definisce un formato da appoggiare
;  su un blocco, non nostro: le prime due parole sono i link (l'idioma di
;  queue.vinc, condiviso da ogni nodo di lista), la terza e' del POOL, e il
;  formato dispone di cio' che comincia a +12. Il pool non conosce nessun
;  formato e non va toccato per aggiungerne uno; e' il formato che si adatta.
;  message.vinc lo fa dal suo lato, dando un nome proprio (PAYLOAD.pool) alla
;  parola che scriviamo noi, ed e' li' che sta scritto perche' a un ricevente
;  serva leggerla.
;
;  "dati" e' un indirizzo, non un campo: BLOCCO.size NON e' la taglia di un
;  blocco e ".res BLOCCO" non va usata — si usano le BLOCCOnn qui sotto.
; --------------------------------------------------------------------------
.struct BLOCCO
  .field pointers LINK.size ; +0  i link, annidati da queue.vinc <- l'indirizzo
                            ;     consegnato e' questo, cioe' &blocco.pointers
  .field pool               ; +8  taglia dell'area dati, scritta a pool_init e mai
                          ;     piu' toccata: e' una proprieta' permanente del
                          ;     blocco, non uno stato. Vale anche come stride
                          ;     rispetto a BLOCCO.dati.
  .field dati             ; +12 dati[0]
.ends

; Le sei taglie fisiche: 12 byte di testa piu' l'area dati.
.struct BLOCCO16
  .field pointers LINK.size
  .field pool
  .field dati  POOL_D16
.ends                     ; 28

.struct BLOCCO32
  .field pointers LINK.size
  .field pool
  .field dati  POOL_D32
.ends                     ; 44

.struct BLOCCO64
  .field pointers LINK.size
  .field pool
  .field dati  POOL_D64
.ends                     ; 76

.struct BLOCCO128
  .field pointers LINK.size
  .field pool
  .field dati  POOL_D128
.ends                     ; 140

.struct BLOCCO256
  .field pointers LINK.size
  .field pool
  .field dati  POOL_D256
.ends                     ; 268

.struct BLOCCO512
  .field pointers LINK.size
  .field pool
  .field dati  POOL_D512
.ends                     ; 524

; --------------------------------------------------------------------------
;  Esiti.
;
;  buf_alloc distingue DUE fallimenti di proposito: POOL_VUOTO e' una condizione
;  di runtime da cui si riprova (il gestore dei timeout lascia il descrittore
;  armato e ritenta al tick dopo, §9.2), POOL_ENORME e' un errore di costruzione
;  che non passera' mai. Confonderli in un unico 0 farebbe ritentare per sempre
;  un errore permanente.
;
;  buf_free non ha nessun parametro oltre al buffer: la classe se la legge
;  dentro. Riconosce tre cose che non deve accettare — un buffer che non viene
;  dal pool, un doppio rilascio, e il rilascio di un buffer ANCORA accodato in
;  una lista. Le ultime due si vedono dai link, grazie all'invariante di
;  queue.vasm (un nodo fuori da ogni lista ha fwd == bwd == 0).
; --------------------------------------------------------------------------
.equ POOL_OK        0
.equ POOL_VUOTO     1   ; classe esaurita: riprovare piu' tardi
.equ POOL_ENORME    2   ; richiesta oltre la classe piu' grande
.equ POOL_ESTRANEO  3   ; il buffer non viene dal pool (taglia non valida, o 0)
.equ POOL_LINKED    4   ; il buffer sta ancora in una lista: doppio rilascio
