; kernel/timeout.vasm — gestore dei timeout: il vettore di descrittori e le due
; primitive con cui un cliente arma e cancella un'attesa a tempo (§9 della
; proposta).
;
; Un timeout e' UNA CONSEGNA IN MAILBOX CHE AVVIENE PIU' TARDI: chi vuole un
; tempo massimo chiede qui che gli venga recapitato un messaggio a una certa
; scadenza, poi si blocca sulla propria mailbox come si bloccherebbe comunque, e
; al risveglio distingue l'evento vero dalla scadenza guardando cosa ha
; ricevuto. L'interfaccia e' PROCEDURALE (due call, non due messaggi) e il
; cliente non fornisce nessun buffer: alla scadenza il buffer lo prende il
; gestore da un pool.
;
; --- Identita', non handle ---
; timeout_arm non restituisce nessun handle e timeout_cancel non ne chiede uno:
; si cancella per IDENTITA', la coppia (replyMailbox, clientTag). Le due parole
; sono gia' nel descrittore perche' servono comunque a formattare il messaggio,
; e il cliente le ha gia' entrambe — la mailbox e' la sua identita' (§8.6) e il
; clientTag lo tiene comunque per riconoscere il messaggio stantio (§9.4).
; Un handle nominerebbe lo SLOT, non il timeout: lo slot sopravvive al timeout e
; viene riciclato, quindi il nome resta valido mentre punta a un'altra cosa e una
; cancel stantia colpirebbe il timeout di un terzo che non ha sbagliato niente.
; Validarlo richiederebbe esattamente il confronto di identita' che facciamo qui.
;
; --- Un vettore, non una lista ---
; Il descrittore non entra mai in una lista (§9.3): niente fwd/bwd, niente
; remove_buffer, niente campo che dica da quale testa sganciare. Il costo e'
; scandire N caselle invece dei soli armati; con N nell'ordine della decina e'
; rumore, e la delta list resta l'evoluzione nota se N cresce.
;
; --- Sezione critica ---
; arm e cancel girano nei TASK e toccano lo stesso vettore che il gestore
; scandira' a ogni tick: la sezione critica e' obbligatoria e sta DENTRO le due
; routine, non in un wrapper _s. Stesso argomento della receive (§8.5): la
; protezione deve comprendere la scansione E la decisione E la scrittura, che
; qui sono un atto solo. Proteggere solo una parte sarebbe attivamente dannoso.
; irq_save/irq_restore sono componibili, quindi le due chiamate sono corrette
; anche da IE=0 (boot).
;
; --- La scansione c'e', la CONSEGNA no, ed e' il confine della cartella ---
; timeout_expired (in fondo) trova la prima scadenza, la formatta nel buffer che
; il chiamante gli porta e libera la casella. Non manda niente: send e receive
; stanno in rtos/, e un modulo di generic/ che li nominasse smetterebbe di essere
; generic (la regola sta in generic/CMakeLists.txt). Il ciclo del task-gestore
; sta quindi in rtos/timeout_manager/, e questo file resta con i soli irq_save/
; irq_restore, la stessa firma esatta di queue.vasm.
;
; Quello che NON si poteva spezzare e' il motivo per cui la primitiva formatta
; invece di limitarsi a restituire i campi: la transizione ARMED -> FREE deve
; stare NELLA STESSA sezione critica in cui si decide di consegnare. Leggere i
; campi, uscire, mandare e solo dopo liberare riaprirebbe qui dentro esattamente
; il bug del riciclo dell'handle. Il formato del payload e' generic (§8.4,
; generic/message), quindi formattare non porta dentro niente di rtos.
;
; Convenzione registri: r1..r4 argomenti, r2 esito, r5..r8 scratch. NON tocca
; r9..r13, cosi' un chiamante che scandisce o accumula puo' tenerci il proprio
; stato attraverso la call.

.include "timeout/timeout.vinc"
.include "message/message.vinc"   ; il formato che timeout_expired compone

  .data

  .global tmo_now
  .global tmo_vector

; Base dei tempi: contatore ASSOLUTO dei tick. Sta qui perche' e' lo stato del
; gestore, ma l'incremento appartiene al percorso del tick, che non e' ancora
; scritto: il test lo muove a mano, ed e' esattamente cosi' che si simula il
; tempo che passa senza avere un timer armato.
tmo_now:      .word 0

; Il vettore. La sua taglia e' "quante righe .res ci sono": per cambiarla si
; aggiunge o si toglie una riga, e tmo_end la segue da sola — nessuna costante
; da tenere allineata a mano con l'allocazione. Nasce tutto TMO_FREE perche'
; l'immagine dati e' azzerata e TMO_FREE vale 0.
tmo_vector:  .res DESCRIPTOR
              .res DESCRIPTOR
              .res DESCRIPTOR
              .res DESCRIPTOR
              .res DESCRIPTOR
              .res DESCRIPTOR
              .res DESCRIPTOR
              .res DESCRIPTOR
              .res DESCRIPTOR
              .res DESCRIPTOR
tmo_end:

  .text

  .global timeout_arm
  .global timeout_cancel
  .global timeout_expired
  .extern irq_save
  .extern irq_restore

; ==========================================================================
;  timeout_arm(r1 = ritardo in tick, r2 = clientTag, r3 = messageCode,
;              r4 = replyMailbox) -> r2 = TMO_OK | TMO_FULL | TMO_DUP
;
;  UNA SOLA passata fa due lavori: cerca il primo slot libero e, sugli armati,
;  controlla che l'identita' non ci sia gia'. L'invariante che ne esce —
;  "al piu' un timeout armato per (replyMailbox, clientTag)" — e' quello che
;  permette alla cancel di fermarsi al primo match. Regge da se' finche' il
;  clientTag e' monotono per attesa (§9.4); se un task vuole due timeout in
;  volo deve usare due tag, cosa che gli serve comunque per distinguerli al
;  risveglio.
;
;  Il ritardo diventa subito una scadenza ASSOLUTA: e' il gestore a possedere la
;  base dei tempi, il cliente ragiona in "fra quanto".
;
;  Non-foglia, con salti -> prologo/epilogo a mano (dentro .proc non sono
;  ammesse etichette, docs/manual.md §4.2.1).
;  Clobber: r1 (diventa la scadenza), r2 (esito), r5, r6, r7, r8. r3/r4 intatti.
; ==========================================================================
timeout_arm:
  addi r14, r14, -4
  sw r15, 0(r14)          ; non-foglia: preserva il ritorno
  call irq_save           ; r5 = psw del chiamante, IE = 0
  addi r14, r14, -4
  sw r5, 0(r14)           ; la psw sopravvive alle call seguenti

  li r5, tmo_now
  lw r5, 0(r5)
  add r1, r1, r5          ; r1 = adesso + ritardo = scadenza assoluta

  li r5, tmo_vector      ; r5 = cursore
  li r7, tmo_end         ; r7 = sentinella di fine vettore
  li r6, 0                ; r6 = primo slot libero visto (0 = ancora nessuno)

arm_scan:
  beq r5, r7, arm_result
  lw r8, DESCRIPTOR.state(r5)
  beq r8, r0, arm_free        ; TMO_FREE == 0
  lw r8, DESCRIPTOR.replyMailbox(r5)
  bne r8, r4, arm_next        ; armato ma di un altro task
  lw r8, DESCRIPTOR.clientTag(r5)
  beq r8, r2, arm_dup           ; stessa mailbox E stesso tag: stessa identita'
  j arm_next
arm_free:
  bne r6, r0, arm_next        ; ne ho gia' uno: tengo il PRIMO
  mov r6, r5
arm_next:
  addi r5, r5, DESCRIPTOR.size
  j arm_scan

arm_result:
  beq r6, r0, arm_full
  sw r1, DESCRIPTOR.expiry(r6)
  sw r4, DESCRIPTOR.replyMailbox(r6)
  sw r2, DESCRIPTOR.clientTag(r6)
  sw r3, DESCRIPTOR.messageCode(r6)
  li r8, TMO_ARMED
  sw r8, DESCRIPTOR.state(r6)  ; lo stato per ULTIMO, dopo i dati: qui dentro la
                                ; sezione critica rende l'ordine indifferente, ma
                                ; e' l'ordine giusto e non costa niente
  li r2, TMO_OK
  j arm_exit
arm_full:
  li r2, TMO_FULL
  j arm_exit
arm_dup:
  li r2, TMO_DUP

arm_exit:
  lw r5, 0(r14)
  addi r14, r14, 4
  call irq_restore        ; psw del chiamante (r2 = esito, non toccato)
  lw r15, 0(r14)          ; dopo la call: irq_restore passa da r15
  addi r14, r14, 4
  ret

; ==========================================================================
;  timeout_cancel(r1 = replyMailbox, r2 = clientTag) -> r2 = TMO_OK | TMO_NONE
;
;  Cancellare e' riportare la casella a TMO_FREE. Gli altri campi restano
;  scritti: la scansione salta le caselle non armate PRIMA di guardare
;  l'identita', quindi non ingannano nessuno, e in un dump raccontano cosa
;  c'era.
;
;  TMO_NONE non e' un fallimento: il timeout puo' aver vinto la corsa, e allora
;  il messaggio e' gia' in mailbox. Quello e' del ricevente (§9.4).
;
;  Clobber: r2 (esito), r5, r6, r7, r8. r1/r3/r4 intatti.
; ==========================================================================
timeout_cancel:
  addi r14, r14, -4
  sw r15, 0(r14)
  call irq_save
  addi r14, r14, -4
  sw r5, 0(r14)

  li r5, tmo_vector
  li r7, tmo_end
  li r6, TMO_NONE         ; esito finche' non si trova

can_scan:
  beq r5, r7, can_exit
  lw r8, DESCRIPTOR.state(r5)
  beq r8, r0, can_next        ; libera: l'identita' non si guarda nemmeno
  lw r8, DESCRIPTOR.replyMailbox(r5)
  bne r8, r1, can_next
  lw r8, DESCRIPTOR.clientTag(r5)
  bne r8, r2, can_next
  sw r0, DESCRIPTOR.state(r5)  ; TMO_FREE: la casella torna libera
  li r6, TMO_OK
  j can_exit                  ; identita' unica: si ferma al primo match
can_next:
  addi r5, r5, DESCRIPTOR.size
  j can_scan

can_exit:
  mov r2, r6
  lw r5, 0(r14)
  addi r14, r14, 4
  call irq_restore
  lw r15, 0(r14)
  addi r14, r14, 4
  ret

; ==========================================================================
;  timeout_expired(r1 = &buffer) -> r2 = TMO_OK | TMO_NONE
;
;  UNA scadenza per chiamata: trova la prima casella armata la cui scadenza e'
;  passata, ci formatta sopra il messaggio nel buffer del chiamante, e libera la
;  casella. TMO_NONE vuol dire "nessuna scadenza adesso", che non e' un errore ma
;  la condizione di uscita del ciclo di chi drena.
;
;  --- PERCHE' FORMATTA, INVECE DI RESTITUIRE I CAMPI ---
;  Perche' la transizione ARMED -> FREE deve stare nella STESSA sezione critica
;  in cui si decide di consegnare. Restituire i campi al chiamante e lasciare a
;  lui la liberazione vorrebbe dire uscire dalla sezione critica con una casella
;  ancora armata e gia' promessa: da li' un secondo giro la troverebbe di nuovo,
;  e una timeout_cancel del cliente cancellerebbe un timeout gia' consegnato.
;  E' il bug del riciclo dell'handle (§9.5) rientrato dalla finestra.
;
;  Formattare non porta qui dentro niente di rtos: il formato del payload e'
;  generic/message (§8.4), e il messaggio non viene MANDATO da qui -- ci pensa
;  il task di rtos/timeout_manager, che legge dal payload appena scritto anche
;  dove mandarlo.
;
;  --- IL BUFFER ARRIVA GIA' PRESO, E NON E' UN DETTAGLIO ---
;  Il chiamante fa buf_alloc PRIMA di chiedere una scadenza. Cosi' una scadenza
;  non puo' essere consumata senza un posto dove metterla, e il "pool vuoto: il
;  timeout arriva tardi invece di non arrivare" di §9.2 diventa strutturale
;  invece che un ramo da ricordarsi: senza buffer non si arriva nemmeno a
;  guardare il vettore.
;
;  PAYLOAD.pool NON si scrive: quella parola e' BLOCCO.pool, l'ha scritta
;  pool_init e dice la provenienza del buffer (message.vinc). Il formato
;  comincia dopo.
;
;  Non-foglia, con salti -> prologo/epilogo a mano.
;  Clobber: r2 (esito), r3, r4, r5, r6, r7, r8. r1 (il buffer) intatto.
; ==========================================================================
timeout_expired:
  addi r14, r14, -4
  sw r15, 0(r14)
  call irq_save
  addi r14, r14, -4
  sw r5, 0(r14)

  li r5, tmo_now
  lw r5, 0(r5)            ; adesso. Si legge QUI dentro: e' l'ISR del tick a
                          ; muoverlo, ed e' l'unica parola di questo modulo che
                          ; qualcun altro scrive
  li r6, tmo_vector
  li r7, tmo_end
  li r2, TMO_NONE         ; esito finche' non si trova

sca_scan:
  beq r6, r7, sca_exit
  lw r8, DESCRIPTOR.state(r6)
  beq r8, r0, sca_next        ; TMO_FREE: non c'e' niente da far scadere
  lw r8, DESCRIPTOR.expiry(r6)
  sub r8, r8, r5                ; LA DIFFERENZA, mai i valori (§9.3): al wrap del
                                ; contatore i confronti diretti invertono
                                ; l'ordine delle scadenze
  blt r0, r8, sca_next        ; scadenza ancora nel futuro
                                ; (differenza <= 0 => e' passata, o e' adesso)

  ; --- scaduta: si formatta il messaggio nel buffer del chiamante ---
  addi r3, r1, MESSAGGIO.payload  ; la testa comune del payload (§8.4). Serve un
                                  ; registro perche' .equ non fa espressioni:
                                  ; MESSAGGIO.payload + PAYLOAD.x non e'
                                  ; scrivibile, la somma si fa a runtime
  li r4, MSG_REPLY                ; una scadenza e' una RISPOSTA: il cliente l'ha
                                  ; chiesta con timeout_arm
  sw r4, PAYLOAD.messageType(r3)
  lw r4, DESCRIPTOR.clientTag(r6)
  sw r4, PAYLOAD.clientTag(r3)    ; e' con questo che il cliente riconosce un
                                  ; messaggio stantio (§9.4)
  lw r4, DESCRIPTOR.messageCode(r6)
  sw r4, PAYLOAD.messageCode(r3)
  lw r4, DESCRIPTOR.replyMailbox(r6)
  sw r4, PAYLOAD.replyMailbox(r3) ; anche DOVE va: il chiamante lo rilegge da qui
                                  ; invece di riceverlo in un registro, cosi' il
                                  ; messaggio e' autosufficiente

  sw r0, DESCRIPTOR.state(r6)    ; TMO_FREE, PRIMA di uscire dalla sezione
                                  ; critica: e' l'invariante di tutta la routine
  li r2, TMO_OK
  j sca_exit
sca_next:
  addi r6, r6, DESCRIPTOR.size
  j sca_scan

sca_exit:
  lw r5, 0(r14)
  addi r14, r14, 4
  call irq_restore
  lw r15, 0(r14)
  addi r14, r14, 4
  ret
