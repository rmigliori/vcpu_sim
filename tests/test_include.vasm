; tests/test_include.vasm — test mirato di `-I` e dell'idempotenza di .include.
;
; Verifica una proprieta' dell'ASSEMBLER, non un comportamento della macchina,
; e non ha bisogno del link: gira in modalita' legacy a file singolo. La
; macchina serve solo a rendere osservabile l'esito, stampando costanti che
; vengono da due file di interfaccia diversi.
;
; Le tre .include qui sotto nominano DUE file, non tre: tcb.vinc arriva una
; volta per nome qualificato (risolto da -I) e una per percorso relativo
; (risolto rispetto alla cartella di QUESTO file, che essendo il file di primo
; livello e' anche la base di ricerca). Sono due grafie dello stesso file, e
; l'assembler lo riconosce canonicalizzando il path con realpath: la seconda
; .include e' un no-op.
;
; I due modi in cui questo test fallisce:
;   senza idempotenza  -> asm error: duplicate constant TCB.pointers
;   senza il -I giusto -> cannot open include 'tcb/tcb.vinc'
;
; Il secondo e' diventato il punto della cosa dal 06/09/2026. Prima tutti i
; .vinc stavano in una cartella sola e un -I li serviva tutti, quindi la
; dichiarazione di dipendenza era un commento; ora ogni libreria propaga la
; propria cartella e il nome porta il nome della libreria, quindi includere
; senza aver dichiarato NON assembla. Questo file e' l'unico che i -I se li
; scrive a mano — non essendo un target non li riceve da INTERFACES — e la sua
; riga nel CMakeLists dice quali e perche'.
;
; Atteso, in ordine:  16 12 16 512 1

.include "tcb/tcb.vinc"                                  ; via -I
.include "../rtos/scheduler/interface/tcb/tcb.vinc"      ; stesso file, altra grafia
.include "pool/pool.vinc"                                ; secondo fornitore, via -I

  .text

main:
  li r1, TCB.size       ; 24 — da tcb.vinc, definita una volta sola
  dumps r1
  li r2, TCB.state      ; 16 — l'offset, non solo la taglia
  dumps r2
  li r3, POOL_D16       ; 16 — da pool.vinc: il secondo fornitore c'e'
  dumps r3
  li r4, POOL_D512      ; 512
  dumps r4
  li r5, RUNNING        ; 1 — uno stato, non un offset
  dumps r5
  halt
