; altimetro/altimetro.vinc — l'altimetro: la macchina a stati della time line
; (25/10/2026, la forma di §3.99 con le correzioni di §3.100).
;
; E' un'APPLICAZIONE, non una libreria: usa le attivita' di lib_eco (dsp/) e
; il kernel con `wait` (rtos/), e dsp/ non puo' dipendere da rtos/.
;
; --- LE DUE CPU (25/10/2026): il CONTROLLO e il PRODOTTO ---
; La CPU 0 e' lo strumento: la time line, l'inseguimento, l'anello chiuso a
; 1 ms. La FFT e' del prodotto, non dell'inseguimento (§3.89), e la fa la
; CPU 1: MSG le manda la testa dello sweep e il numero del blocco, e lei
; legge lo stesso blocco nel ping-pong dell'ADC (ADC_BUF), intero, finche' il
; contatore dei blocchi dice che e' ancora quello.
;
; --- COME SI AVVIA ---
;     j altimetro_parti     dal boot, a IE = 0, dopo sched_init e dopo aver
;                           creato gli altri task. Non torna: diventa il SUPER
;                           TASK, nel banco alternativo
; Chi la chiama ha gia' fatto sched_init; tutto il resto -- la WAIT, l'ISR,
; la via veloce, il ferro, il cane da guardia -- lo fa lei.
;
; --- LA TIME LINE E' UNA TABELLA PER MODO ---
; Voci {ancora, durata, procedura}. Le ancore sono la regola di §3.89 ("tutto
; calcolato da t0") scritta come dato:
;     ALT_FINESTRA   AT + ECO_W: FRONTE, a blocco finito
;     ALT_PREC       l'istante della voce prima + la sua durata
; Il TX non ha uno slot: lo arma DECIDI con TX_AT, e la finestra la arma il
; TRACKER con ADC_AT (§3.100). LA PRIMA VOCE DI OGNI TABELLA E' ANCORATA ALLA
; FINESTRA: il giro arma la sveglia della prima voce del frame dopo PRIMA di
; chiamare DECIDI, che sceglie la tabella, e la legge dalla tabella corrente.
;
; --- I MODI e la sequenza, §3.82 ---
;     CAL    5 sweep: FRONTE, TRACKER. Passa se tutti e 5 sono NOMINALI e i
;            residui degli sweep 3..5 stanno sotto 1 gate; se no resta in CAL,
;            con la finestra dov'e' e il filtro da capo
;     ACQ    5 sweep: + BARKER_ACC; al quinto (ACQ5) + BARKER_DEC. Passa se
;            BARKER_DEC trova e il suo fronte sta entro 1 gate dal tracker;
;            se no torna in CAL, con la finestra dov'e'
;     TRACK  + MSG, alla CPU 1. Due sweep non nominali DI FILA: da
;            capo, in CAL con la finestra a priori
;
; --- I SIMBOLI PUBBLICATI: le statistiche, che nessuno azzera ---
;     alt_k            i frame finiti
;     alt_modo_svolto  il modo del frame appena finito (lo scrive DECIDI)
;     alt_sforamenti   le wait tornate con pending > 0: una voce in ritardo
;     alt_sfora_max    il ritardo piu' grande, CLOCK_CYCLES - istante, in cicli
;     alt_non_finiti   FRONTE ha trovato il blocco non finito
;     alt_ritardi      un armamento di TX_AT o ADC_AT in ritardo
;     alt_overrun      le parole di MSG perse nella mailbox
;     alt_stat         il tempo della time line, per procedura (sotto)
;     alt_stat_persi   i record buttati con l'anello pieno
; e in RAM CONDIVISA (altimetro_shared.vasm, da linkare in tutte le immagini):
;     alt_record       le due teste di MSG (eco.vinc), alternate per parita'
;                      con passo ECO_REC_TESTA: lo spettro non viaggia
; --------------------------------------------------------------------------
.equ ALT_PRI       100000        ; un frame, 1 ms: cicli
.equ ALT_T0        20000         ; il TX del frame 0, assoluto: dopo il boot
.equ ALT_APRIORI   59999         ; AT - TX a priori: con l'acqua a 90 km il
                                 ; fronte cade ~10 gate dopo il centro (§3.82)
.equ ALT_TX_LEN    5000          ; 50 us
.equ ALT_GUARDIA   5             ; il cane da guardia, in ms: DECIDI lo riarma

.equ ALT_CAL       1             ; i modi: da 1, cosi' una sequenza in cifre
.equ ALT_ACQ       2             ; decimali si legge
.equ ALT_TRACK     3
.equ ALT_SWEEP     5             ; gli sweep di CAL e di ACQ

.equ ALT_FINESTRA  0             ; le ancore
.equ ALT_PREC      1
;
.equ ALT_P_FINE        0         ; gli indici delle procedure: nelle tabelle
.equ ALT_P_FRONTE      1         ; della time line, e le righe di alt_stat
.equ ALT_P_TRACKER     2
.equ ALT_P_BARKER_ACC  3
.equ ALT_P_BARKER_DEC  4
.equ ALT_P_MSG         5
.equ ALT_P_DECIDI      6
.equ ALT_P_N           7         ; le righe, la 0 non si usa

; --------------------------------------------------------------------------
;  LE STATISTICHE DELLA TIME LINE (25/10/2026, §3.103)
;
;  IL RECORD lo scrive il super task, ALLA SORGENTE (§3.88): una voce, quattro
;  parole. I tre istanti sono tutti in base CLOCK_CYCLES:
;      proc      l'indice della procedura, + ALT_REC_BUCO se prima di questo
;                record il super task ne ha buttati (l'anello era pieno)
;      istante   quello PROGRAMMATO, cioe' armato in CMP0
;      sveglia   letto appena la wait torna
;      fine      letto appena prima della wait dopo: comprende il giro
;  Gli istanti si sottraggono modulo 2^32, come i comparatori.
;
;  L'ANELLO, in RAM locale: alt_anello, ALT_ANELLO record. Uno scrittore, il
;  super task, che riempie lo slot in testa alla sveglia e alla fine lo
;  PUBBLICA spostando alt_testa; un lettore, che sposta alt_coda. Sulla stessa
;  CPU il lettore non interrompe mai lo scrittore: niente interrupt chiusi.
;  Pieno, lo scrittore butta il record e lo conta: non aspetta mai.
;
;  IL LETTORE e' alt_statistiche, chiamata in giro dal TASK DELLE
;  STATISTICHE, che e' dell'integratore (il livello, lo stack, cosa fare dopo):
;      call alt_statistiche    aspetta un frame finito (sem_wait su alt_sem,
;                              che il super task posta a ogni frame), svuota
;                              l'anello in alt_stat; r1 = i frame finiti da
;                              quando era tornata l'ultima volta. 0 se il
;                              frame l'aveva gia' visto, > 1 se gliene sono
;                              sfuggiti. Clobber: r1..r10
;  Il task NON USA I VETTORI: il super task lo interrompe a ogni slot, e la via
;  veloce vale solo per chi non li ha sporchi (hal.vinc).
;
;  alt_stat, una riga di ALT_STAT per procedura, che nessuno azzera:
;      conteggio  i record
;      ritardo    il massimo di sveglia - istante: la sveglia del super task
;      lavoro     il massimo di fine - sveglia
;      margine    il minimo di (l'istante della voce dopo) - fine. Fra due
;                 record con un buco in mezzo non si calcola
;      regola     il minimo di durata - ALT_MECCANISMO - 1,25 x lavoro, con
;                 durata = l'istante della voce dopo - istante: la regola dei
;                 budget di §3.86. Negativo = lo slot e' stretto per la regola,
;                 anche se non ha sforato
; --------------------------------------------------------------------------
.struct ALT_REC
  .field proc
  .field istante
  .field sveglia
  .field fine
.ends
.equ ALT_REC_BUCO    256
.equ ALT_ANELLO      64          ; record: 1 KiB, una dozzina di frame di TRACK
.equ ALT_ANELLO_MASK ALT_ANELLO * ALT_REC.size - 1

.struct ALT_STAT
  .field conteggio
  .field ritardo
  .field lavoro
  .field margine
  .field regola
.ends
.equ ALT_MECCANISMO  327         ; i cicli di meccanismo a slot (§3.86)
