; altimetro/src/altimetro_shared.vasm — la RAM condivisa dell'altimetro
; (25/10/2026). Nessun codice: va linkato in TUTTE le immagini della scheda,
; nello stesso ordine, perche' l'indirizzo lo decide la regione SHARED del
; file di collocazione e due immagini non d'accordo non partono (§3.80).
;
; Il blocco dell'ADC non sta qui dal 25/10: e' nel ping-pong dell'ADC
; (ADC_BUF), dove tutte e due le CPU lo leggono intero.

.include "eco/eco.vinc"

.equ DUE_REC_W  ECO_REC_TESTA_W * 2

  .shared
alt_record:  .space DUE_REC_W    ; le due teste di MSG, alternate per parita'
