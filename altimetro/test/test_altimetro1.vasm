; altimetro/test/test_altimetro1.vasm — IL PERCORSO NOMINALE: la CPU 1, chi
; riceve gli sweep di TRACK (25/10/2026). Il compagno di test_altimetro0.vasm.
;
; --- COSA FA ---
; In polling, niente interrupt: riceve n dalla mailbox, ricava il record
; dalla parita' e lo legge col protocollo di eco.vinc -- ECO_REC_N prima e
; dopo, e in mezzo tutto il record, spettro compreso. Un record e' BUONO se
; e' intatto e il suo esito e' ECO_NOMINALE. Quando la CPU 0 alza `fine`, e
; la mailbox e' vuota, stampa.
;
; --- IL FRONTE DELL'ULTIMO SWEEP, contato a mano e non da mare.py ---
; Il TX del frame k parte a t_k = ALT_T0 + k ALT_PRI, esatto (TX_AT). Il
; ritardo e' tau_k = 2 (R0 + v t_k) / (c - v) (il modello di mare.py, scritto
; nel suo commento), con R0 = 90.000 m, v = 375 m/s, c = 299.792.458 m/s. Per
; k = 14: t = 1.420.000 cicli = 14,2 ms, R = 90.005,325 m, tau = 600,451647 us
; = 60.045,1647 cicli. Il fronte che FRONTE misura, in ritardo dal TX, e'
; z = (AT - TX) + 1 + posizione (eco.vinc), e il test vuole |z - tau| < 1/2
; gate. FRONTE stima la meta' del PICCO, e il rumore lo gonfia: su 30 semi
; test_fronte misurava il fronte +0,09 gate in media, sigma 0,12.
;
; --- I QUATTRO NUMERI DELLA CPU 1 ---
;   5    i record buoni: gli sweep 10..14, i cinque di TRACK
;   0    gli altri: persi, riscritti mentre si leggevano, o non nominali
;   14   l'ultimo n buono
;   1    il fronte dello sweep 14 entro mezzo gate da tau
;
; --- ROSSO: le mutazioni di altimetro.vasm, e le uscite previste PRIMA ---
; In fondo al file.

.include "eco/eco.vinc"
.include "hal/amp.vinc"

  .extern alt_record
  .extern fine

.equ N_ULTIMO   14
.equ TAU_ULTIMO 60045.1647       ; cicli, il conto qui sopra
.equ SPETTRO_W  ECO_W * 2
.equ MAGIC_HI   0x4B400000       ; i bit di 1,5 x 2^23: intero -> float
.equ MAGIC      12582912.0

  .data
appoggio: .word 0

  .text
  .global main

main:
  li r9, alt_record
  li r10, 0                      ; buoni
  li r11, 0                      ; gli altri
  li r12, -1                     ; l'ultimo n buono
  li r13, 0                      ; il fronte dell'ultimo, vicino a tau
ricevi:
  li r1, MBOX_STATUS
  lw r2, 0(r1)
  li r3, MBOX_COUNT_MASK
  and r2, r2, r3
  bne r2, r0, leggi
  li r1, fine
  lw r2, 0(r1)
  beq r2, r0, ricevi
  dumps r10                      ; 5
  dumps r11                      ; 0
  dumps r12                      ; 14
  dumps r13                      ; 1
  halt

leggi:
  li r1, MBOX_RECV
  lw r4, 0(r1)                   ; n
  li r1, 1                       ; il record: base + (n & 1) * ECO_REC
  and r1, r4, r1
  li r2, ECO_REC
  mul r1, r1, r2
  add r5, r9, r1
  lw r6, ECO_REC_N(r5)           ; s1
  bne r6, r4, altro
  lw r7, ECO_REC_AT(r5)
  flw f1, ECO_REC_POS(r5)
  lw r8, ECO_REC_ESITO(r5)
  addi r1, r5, ECO_REC_RE        ; lo spettro, tutto, come un lettore vero
  li r2, SPETTRO_W
spettro:
  lw r3, 0(r1)
  addi r1, r1, 4
  addi r2, r2, -1
  bne r2, r0, spettro
  lw r6, ECO_REC_N(r5)           ; s2
  bne r6, r4, altro
  bne r8, r0, altro              ; intatto, ma non nominale
  addi r10, r10, 1
  mov r12, r4
  li r1, N_ULTIMO
  bne r4, r1, ricevi

  ; --- z = AT - TX + 1 + posizione, contro tau ---
  li r1, MAGIC_HI
  add r1, r1, r7
  li r2, appoggio
  sw r1, 0(r2)
  flw f2, 0(r2)
  fli f3, MAGIC
  fsub f2, f2, f3                ; AT - TX in float
  fli f3, 1.0
  fadd f2, f2, f3
  fadd f2, f2, f1                ; z
  fli f3, TAU_ULTIMO
  fsub f2, f2, f3
  fneg f3, f2
  fmax f2, f2, f3                ; |z - tau|
  fli f3, 0.5
  fsub f2, f3, f2                ; positivo se entro mezzo gate
  fsw f2, 0(r2)
  lw r1, 0(r2)
  blt r1, r0, ricevi
  li r13, 1
  j ricevi

altro:
  addi r11, r11, 1
  j ricevi

; ==========================================================================
;  ROSSO, mutazioni di altimetro.vasm su copie nello scratchpad (25/10/2026),
;  con l'uscita prevista PRIMA. L'uscita giusta, CPU 0 | CPU 1:
;      111112222233333 0 0 0 0 | 5 0 14 1
;
;  M1  FRONTE ancorato a PREC invece che alla finestra
;        previsto e uscito:  111111111111111 0 14 0 0 | 0 0 -1 0
;        Il frame 0 parte giusto (l'avvio arma la finestra); dal frame 1 i
;        frame si incatenano a ~3.300 cicli, FRONTE trova il blocco non finito
;        14 volte, il tracker non si inizializza e CAL non passa mai.
;        Con le durate di §3.86 la stessa mutazione non stampava niente: le
;        voci incatenate sforavano tutte, e DECIDI riarmava il cane da guardia
;        lo stesso. Un livelock, dedotto e non visto in traccia
;  M2  il segno del Barker ignorato da BARKER_ACC
;        previsto e uscito:  VERDE. Il §3.99 lo dava rosso, e sbagliava: col
;        segno ignorato la somma vale 3 echi invece di 5, e qui il picco sta
;        ~1.250 volte sopra il rumore. Lo vede solo una scena con poco margine
;  M3  ADC_AT armato senza + ALT_PRI: l'AT del frame corrente, gia' passato
;        previsto il 25/10:  111111111111111 0 14 15 0 -- SBAGLIATO
;        uscito:             11111111111111 3 1 1 0 | 0 0 -1 0
;        Il ritardo c'e' una volta sola. at_dopo e' anche l'ancora del FRONTE
;        del frame dopo, che parte subito, in ritardo; e da li' la time line si
;        assesta UN FRAME INDIETRO, coerente con se stessa, sempre in CAL. Due
;        frame di fila senza idle in mezzo: la sequenza ha una cifra in meno
;  M4  CMP0 armato DOPO l'attivita'
;        previsto e uscito:  VERDE. Si vede solo con uno sforamento provocato,
;        come il passo 2 di test_banco: e' dei rami di fallimento. (Con le
;        durate di §3.86 usciva rosso, 19 ritardi: non per l'ordine, ma per le
;        quattro istruzioni in piu' in un TRACKER che aveva venti cicli di
;        margine)
;  M5  DECIDI non sceglie mai ACQ5: BARKER_DEC non gira
;        previsto e uscito:  111112222211111 0 0 0 0 | 0 0 -1 0
; ==========================================================================
