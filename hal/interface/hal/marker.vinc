; hal/marker.vinc — IL MARCATORE: l'oscilloscopio a piu' tracce.
;
; Un tag all'inizio della regione che interessa e uno alla fine, con due
; identificatori -- la CATEGORIA della misura e il PUNTO dentro quella
; categoria. E' il toggle di un GPIO guardato con l'analizzatore di stato
; logico, che e' come si misura davvero sul ferro; le versioni industriali sono
; le stimulus port dell'ITM di CoreSight e SystemView di SEGGER.
;
; --- COSA MISURA, CHE LA TRACCIA DEL PC NON PUO' ---
; La traccia (tools/trace.py) dice CHI occupava la CPU e in quale intervallo.
; Una finestra aperta in un task e chiusa in un ALTRO dice quanto e' durata una
; RICHIESTA, attraverso le commutazioni: e' il tempo di RISPOSTA. La differenza
; fra i due e' l'INTERFERENZA -- quanto ti e' costato il resto del sistema --
; ed e' il numero che conta in un kernel realtime.
;
; --- IL CANALE E' L'INDIRIZZO, E IL VALORE E' IL PUNTO ---
; Non una parola con dei campi impacchettati: l'assembler non valuta espressioni
; (".equ B (A << 16)" non assembla, verificato), quindi comporre canale e valore
; a tempo di compilazione non si puo'. Il rimedio e' migliore del problema --
; 32 registri contigui, uno per canale, come l'ITM ne ha 32:
;
;     li  r1, MARK_RESPONSE     ; il canale: la CATEGORIA
;     li  r2, P_CONSEGNA         ; il valore: il PUNTO. != 0 APRE
;     sw  r2, 0(r1)
;     ...
;     sw  r0, 0(r1)              ; 0 CHIUDE, e r0 e' gia' zero: UNA istruzione
;
; Aprire costa TRE istruzioni, chiudere UNA. Il costo si conta a mano leggendo
; il listato, ed e' voluto: un probe a costo zero sarebbe comodo e insegnerebbe
; il falso, perche' sul ferro la strumentazione si paga sempre. Si paga anche
; quando la registrazione e' spenta -- la sw viene eseguita lo stesso, e' solo
; la macchina che non annota. IL COSTO STA NEL PROGRAMMA, NON NELL'OPZIONE.
;
; Da cui la regola d'uso: UN TAG E' UNA DOMANDA, non un ornamento. Si mette dove
; stai chiedendo qualcosa e poi o lo togli, o lo tieni perche' quella grandezza
; la vuoi sorvegliare. La sua presenza va giustificata come si giustifica un
; EXPECT, perche' sposta i numeri che dipendono dai cicli.
;
; --- DUE CANALI LI SCRIVE LA MACCHINA, E COSTANO ZERO ---
;   canale 0  ESECUZIONE: chi possiede la CPU. Il registratore osserva le
;             scritture a `current` -- l'indirizzo lo prende dalla tabella dei
;             simboli del .vx, niente da cablare -- e annota i CAMBI. Zero
;             istruzioni nel kernel, e il possesso diventa un DATO invece di
;             un'inferenza dal pc.
;   canale 1  TASTO: quando un carattere diventa disponibile. Serve perche' il
;             programma NON PUO' SAPERLO -- sa quando se n'e' accorto, e fra i
;             due c'e' il ritardo del polling, che e' proprio una delle cose da
;             misurare. Senza questo canale il tempo di risposta non e'
;             scrivibile con i soli tag applicativi.
;
; Scriverci da programma e' un errore e la macchina lo dice.
;
; --- I NOMI CI SONO, E NON STANNO QUI ---
; Questo file dichiara i canali GREZZI: un indirizzo per canale, e basta. I nomi
; -- categorie, marker, e come si chiamano a schermo -- stanno in `marks.conf`
; alla radice, da cui `tools/marks.py generate` produce il .vinc con gli .equ
; che il programma include (`marks/marks.vinc`, nell'albero di build). Una
; sorgente, due consumatori: l'assembler che vuole gli .equ e il lettore che
; vuole i nomi, che e' il motivo per cui il catalogue esiste separato.
;
; Quindi NON si dichiarano i nomi con degli .equ al punto d'uso sui canali
; generici qui sotto: sarebbe la seconda verita' che marks.conf esiste per
; togliere. I canali qui sotto restano per chi vuole un colpo di sonda senza
; dichiarare niente, e per quello soltanto.
;
; --- E ADESSO SI VEDONO ---
; Dal 13/09/2026 `tools/trace.py` legge la registrazione e la DISEGNA nella
; stessa pagina della traccia: una corsia per categoria, ogni finestra rigata
; dai tratti di chi possedeva la CPU dentro di essa, e la sovrapposizione
; allineata al trigger, dove il jitter si vede. Nella stessa pagina e non in
; un'altra perche' una finestra che attraversa una commutazione si legge solo
; sotto le commutazioni che attraversa.
; Il testo nel terminale resta: `python3 tools/marks.py read marks.conf <rec>`.
;
; File FOGLIA: non include niente.

; --- IL PORTO DATI: una marca che si porta dietro un VALORE ---
;
; La sw della marca porta UNA parola, e quella e' gia' il marker (quale punto).
; Il secondo valore -- il codice del messaggio appena ricevuto, la profondita'
; di una coda -- vuole un secondo porto, uno per canale, a MARKD_*:
;
;     li  r7, MARKD_CH6
;     sw  r4, 0(r7)          ; ARMA: il dato che la prossima marca portera'
;     li  r7, MARK_CH6
;     li  r3, M_RECV_GOT
;     sw  r3, 0(r7)          ; la marca, e se lo porta via
;
; Due istruzioni in piu'. UNO PER CANALE e non uno globale: con un porto solo,
; un tick fra l'armamento e la marca -- e l'ISR che ne emette una sua --
; mangerebbe il dato, e sarebbe un guasto raro e silenzioso.
;
; La macchina si ricorda anche SE era armato, non solo cosa c'era: zero e' un
; valore legittimo, quindi senza quel bit "il dato era 0" e "mi sono
; dimenticato di armare" avrebbero lo stesso aspetto. Una categoria che
; dichiara `data` in marks.conf e riceve una marca senza dato e' un errore
; DETTO, non uno zero plausibile.
;
; Ogni armamento serve UNA marca: dopo, il canale torna disarmato.

.equ MARK_EXEC    0x100100      ; canale 0 — RISERVATO alla macchina
.equ MARK_KEY   0x100104      ; canale 1 — RISERVATO al device

; I canali dell'applicazione. Si rinominano con un .equ al punto d'uso:
;   .equ MARK_RESPONSE  MARK_CH2
.equ MARK_CH2     0x100108
.equ MARK_CH3     0x10010C
.equ MARK_CH4     0x100110
.equ MARK_CH5     0x100114
.equ MARK_CH6     0x100118
.equ MARK_CH7     0x10011C

; I porti dati, uno per canale: MARKD_CHn arma il canale n.
; Stanno a MARK_BASE + 32*4, cioe' subito sopra i canali (include/vcpu.h).
.equ MARKD_CH2    0x100188
.equ MARKD_CH3    0x10018C
.equ MARKD_CH4    0x100190
.equ MARKD_CH5    0x100194
.equ MARKD_CH6    0x100198
.equ MARKD_CH7    0x10019C

; ===========================================================================
;  LE MACRO DEL MARCATORE (14/09/2026, §3.65)
;
;  Fino a oggi ogni tag era scritto a mano al punto d'uso: undici copie delle
;  stesse tre istruzioni, ognuna col suo registro d'appoggio scelto guardando la
;  liveness. Adesso la forma sta scritta qui una volta sola.
;
;  --- PERCHE' MACRO E NON PROCEDURE ---
;  Una procedura sarebbe la forma naturale -- una libreria vuota per il codice di
;  produzione, una piena per quello strumentato, al prezzo di una call e un ret.
;  Il prezzo pero' e' misurato, non teorico: su test_tmgr sono 158 esecuzioni di
;  tag, cioe' ~1% della corsa e ~5% del cammino "pronto -> gira" che
;  scheduler-facts.md §6.1 pubblica -- pagati dal binario DI PRODUZIONE per non
;  fare niente. E morirebbe l'invariante che tools/fingerprint.sh dimostra a ogni
;  sessione: i programmi puliti sono IDENTICI BYTE PER BYTE, cioe' il kernel che
;  misuri e' il kernel che spedisci.
;
;  La macro prende tutto: una definizione sola, e con il corpo vuoto si espande
;  in ZERO istruzioni. L'idea "una vuota e una piena" e' qui sotto, scelta a
;  compile-time invece che a link-time.
;
;  --- DUE FAMIGLIE, PERCHE' SONO DUE COSE ---
;  MARK_*  emette SEMPRE. E' per il codice la cui misura e' parte di cio' che il
;          programma E': test_events esiste per misurare il tempo di risposta a
;          un tasto, e senza i suoi tag non misurerebbe niente.
;  DBG_*   emette SOLO nella configurazione strumentata (-D MARKS). E' per il
;          kernel e per l'HAL, dove la strumentazione deve sparire dal prodotto.
;
;  Distinguerle e' il motivo per cui il punto d'uso non ha piu' nessun `.ifdef`:
;  la domanda "questo tag sopravvive in produzione?" ha una risposta nel NOME.
;
;  --- IL CONTRATTO ---
;  `tmp` e' un registro che la macro SPORCA, e lo sceglie il chiamante perche'
;  solo lui sa chi e' vivo. Non e' una comodita': la chiusura dentro ctx_restore
;  gira quando ogni registro porta gia' un valore del task, e l'unico libero e'
;  quello che la riga dopo ricarica. Una macro che scegliesse da se' lo
;  corromperebbe.
;
;  Aprire costa TRE istruzioni, chiudere DUE. Non una: la chiusura da una sola
;  vale se il registro con l'indirizzo e' sopravvissuto all'intervallo, e in
;  questo progetto non succede in nessuno dei cinque siti.
; ===========================================================================

; --- SEMPRE: la misura e' parte del programma ---
.macro MARK_OPEN ch, mk, tmp, tmp2
  li tmp, ch
  li tmp2, mk
  sw tmp2, 0(tmp)
.endmacro

.macro MARK_CLOSE ch, tmp
  li tmp, ch
  sw r0, 0(tmp)
.endmacro

; Un ISTANTE, non una durata: un canale dichiarato `event` in marks.conf. Si
; scrive e basta, non c'e' niente da chiudere.
.macro MARK_EVENT ch, mk, tmp, tmp2
  li tmp, ch
  li tmp2, mk
  sw tmp2, 0(tmp)
.endmacro

; ARMA il porto dati: il valore che la PROSSIMA marca su quel canale si portera'
; dietro. `val` e' un registro, non una costante.
.macro MARK_DATA chd, val, tmp
  li tmp, chd
  sw val, 0(tmp)
.endmacro

.ifdef MARKS

; --- SOLO STRUMENTATA: in produzione questi non esistono ---
.macro DBG_OPEN ch, mk, tmp, tmp2
  li tmp, ch
  li tmp2, mk
  sw tmp2, 0(tmp)
.endmacro
.macro DBG_CLOSE ch, tmp
  li tmp, ch
  sw r0, 0(tmp)
.endmacro
.macro DBG_EVENT ch, mk, tmp, tmp2
  li tmp, ch
  li tmp2, mk
  sw tmp2, 0(tmp)
.endmacro
.macro DBG_DATA chd, val, tmp
  li tmp, chd
  sw val, 0(tmp)
.endmacro

.else

; LE STESSE QUATTRO, VUOTE: zero istruzioni, zero byte, impronta del programma
; pulito immutata. Che sia una definizione vuota invece di una libreria vuota e'
; precisamente cio' che la rende gratuita.
.macro DBG_OPEN ch, mk, tmp, tmp2
.endmacro
.macro DBG_CLOSE ch, tmp
.endmacro
.macro DBG_EVENT ch, mk, tmp, tmp2
.endmacro
.macro DBG_DATA chd, val, tmp
.endmacro

.endif
