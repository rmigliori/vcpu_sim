; hal/machine.vasm — HAL (Hardware Abstraction Layer): l'UNICO codice che tocca
; l'hardware di questa macchina. Isola il kernel dai dettagli della CPU e del
; timer, cosi' il kernel resta puro (politica + code, nessun CSR).
;
; E' lo strato "port/arch" dei kernel reali: FreeRTOS portable/portASM, Linux
; arch/*/entry.S. Sa: file dei registri, layout del frame di contesto, i CSR
; delle eccezioni (mfepc/mtepc/reti), il vettore di trap, il timer. NON sa nulla
; di ready queue, TCB, current, handler o politica di scheduling.
;
; Contratto col kernel: il contesto salvato di un task e' OPACO. L'HAL lo salva
; sullo stack, ne passa il puntatore (sp) al kernel e riceve indietro il
; puntatore del contesto da riprendere. Il kernel non interpreta mai il frame.
;
; --- Frame di contesto (sullo stack del task, sp = r14, CTX_FRAME_SIZE byte) ---
;   Push, in quest'ordine: r15(ra) [da _trap_entry, raw], poi r1..r13, poi psw e
;   epc [da ctx_save] -> epc finisce in cima (indirizzo piu' basso). r14(sp) NON
;   e' nel frame: e' il puntatore-a-contesto stesso. I registri VETTORIALI (v*,
;   vl, vmask) sono VOLATILI attraverso la preemption (la trap arriva solo al
;   confine d'istruzione: nessuna corsia viva da salvare). Il layout resta
;   privato dell'HAL: il kernel vede solo un puntatore opaco. La taglia sta in
;   hal.vinc, perche' chi costruisce un frame senza passare da ctx_init non deve
;   riscriverla a mano.
;
;   LA PAROLA DI STATO E' NEL FRAME dal 05/09/2026 (§12.5 della proposta).
;   Prima non c'era, e il commento qui diceva perche': "epsw non e' scrivibile e
;   IE=1 e' uniforme (la trap mette IE=0, reti lo riporta a 1)". Quell'uniformita'
;   valeva finche' si torna SEMPRE a un task. Non vale piu' nel momento in cui il
;   ritorno puo' puntare a codice di kernel, che si troverebbe a girare con gli
;   interrupt aperti: da li' `mfepsw`/`mtepsw` nell'ISA e questa parola nel frame.

.include "hal/hal.vinc"

; LE MACRO DEL MARCATORE, e SENZA .ifdef: la definizione dev'essere visibile
; anche quando e' VUOTA, o il punto d'uso non assemblerebbe. E' il prezzo della
; forma macro, e si paga qui invece che a ogni tag -- e' un file FOGLIA di sole
; .equ e .macro, che nella build pulita non emette un byte.
.include "hal/marker.vinc"

; Il catalogo delle misure, e SOLO nella configurazione strumentata -- stessa
; regola di scheduler.vasm: senza -D MARKS non entra ne' l'include ne' i tag,
; e l'HAL pulito resta a zero dipendenze come dichiara il suo CMakeLists.
;
; Che l'HAL includa un file GENERATO dal catalogo di progetto e' voluto e non
; una svista di strato: il porto del marcatore e' roba sua -- sta in
; hal/marker.vinc, e il generato lo include -- quindi qui l'HAL sta leggendo
; quale canale gli e' stato assegnato per misurare SE STESSO. Il numero del
; canale sta in marks.conf e in nessun altro posto, che e' il motivo per cui
; questo include esiste invece di una `.equ` scritta a mano qui.
.ifdef MARKS
.include "marks/marks.vinc"
.endif

  .data

; Il vettore applicativo, registrato con irq_install. Sta QUI e non nel kernel
; (dove stava fino al 05/09/2026) perche' installare un vettore e' hardware, e
; perche' e' questo che rompe la dipendenza HAL -> kernel: l'HAL consegna il
; controllo a un puntatore, non a un nome. Vedi §12.2 della proposta.
g_handler: .word 0        ; puntatore all'ISR applicativa (indice istruzione)

.ifdef BANCO
; La via veloce del super task (hal.vinc, "LA VIA VELOCE"). La causa che la
; prende la dice irq_arm_banco; -1 non e' una causa, quindi senza irq_arm_banco
; non la prende nessuno.
g_causa_banco: .word -1
g_pendente:    .word 0    ; il frame di banco il cui banco 0 e' ancora VIVO, o 0
g_bersaglio:   .word 0    ; appoggio della materializzazione
.endif

  .text

  .global _trap_entry
  .global ctx_restore
  .global ctx_init
  .global hal_ctx_block
  .global timer_init
  .global irq_arm
  .global irq_install
  .global irq_enable
  .global irq_save
  .global irq_restore
  .global hal_ctx_block_super
.ifdef BANCO
  .global _trap_entry_banco
  .global irq_arm_banco
.endif

; ==========================================================================
;  _trap_entry: VETTORE di trap del timer. All'ingresso r14 = sp del task
;  interrotto, IE=0, epc = pc dell'istruzione interrotta, r1..r15 sono ancora
;  live (il task interrotto ce li teneva). Salva il contesto e CONSEGNA IL
;  CONTROLLO ALL'ISR APPLICATIVA, con r1 = contesto opaco.
;
;  L'HAL finisce qui: non sa cosa fara' l'ISR, e non nomina un solo simbolo di
;  kernel. E' l'ISR — codice applicativo — a essere cliente sia dell'HAL sia del
;  kernel, e a decidere come si esce (§12.4: all'istruzione interrotta, allo
;  scheduler, o al dispatcher). Fino al 05/09/2026 qui c'era invece una
;  `call sched_dispatch`: il kernel stava IN MEZZO fra il vettore e l'ISR, e da
;  li' veniva il ciclo hal -> kernel -> hal (§12.1).
;
;  `jr` e non `jalr`: l'ISR non torna qui. Il vettore consegna e sparisce.
;
;  Il push raw di r15 qui sotto e' l'UNICA istruzione dell'intero HAL che deve
;  restare a mano invece di stare dentro ctx_save: "call" e' sempre "jal r15,
;  target" (r15 cablato come link register, vedi assembler), quindi qualunque
;  call fatta prima di aver salvato r15 lo distruggerebbe mentre contiene
;  ancora il valore live del task interrotto. Va salvato per primo, senza call.
; ==========================================================================
_trap_entry:
  addi r14, r14, -4
  sw r15, 0(r14)          ; DEVE precedere ogni call: vedi nota sopra
  call ctx_save           ; HAL: salva r1..r13 + psw + epc; r1 = contesto opaco
  li r5, g_handler
  lw r5, 0(r5)
  jr r5                   ; consegna all'ISR applicativa (r1 = contesto)

.ifdef BANCO
; ==========================================================================
;  _trap_entry_banco: il vettore con la VIA VELOCE del super task (§3.86).
;
;  All'ingresso e' tutto vivo, come in _trap_entry, e la trap NON ha cambiato
;  banco: siamo in quello dell'interrotto. Tre domande, prima di toccare un
;  registro che non sia r1 (condiviso, e messo subito al suo posto nel frame):
;
;    l'interrotto era gia' nel banco alternativo?   lo sforamento, o una trap
;      dentro il super task: il banco e' suo e vivo -> via canonica
;    aveva i vettori vivi?   il banco non li copre -> via canonica
;    e' la causa registrata?   questa si chiede GIA' nel banco alternativo, i
;      cui registri sono liberi per la regola della wait
;
;  La via veloce non salva niente dell'interrotto: riserva sul suo stack un
;  frame canonico con i float (CTX_BANCO_SIZE), ci scrive flag, epc, psw e r1
;  agli stessi posti, e se lo segna in g_pendente. La consegna all'ISR e'
;  quella di sempre: r1 = r14 = contesto. L'ISR non sa da che via e' arrivata.
;
;  Le posizioni, da P = sp - 132: +0 flag, +68 epc, +72 psw, +124 r1. Sono quelle
;  del frame canonico con il blocco float, e servono alla materializzazione.
; ==========================================================================
_trap_entry_banco:
  sw r1, -8(r14)          ; r1 al suo posto: P + 124 (e anche nel frame canonico)
  mfepsw r1
  slli r1, r1, 60         ; PSW_BANK (bit 3) nel bit del segno
  blt r1, r0, teb_canonico
  mfepsw r1
  slli r1, r1, 62         ; PSW_VDIRTY (bit 1) nel bit del segno
  blt r1, r0, teb_canonico
  li r1, PSW_BANK
  mtpsw r1                ; banco alternativo, IE = 0: r2..r13, r15 sono liberi
  mfcause r2
  li r3, g_causa_banco
  lw r3, 0(r3)
  bne r2, r3, teb_torna

  mfepc r2
  sw r2, -64(r14)         ; epc: P + 68
  mfepsw r2
  sw r2, -60(r14)         ; psw: P + 72
  addi r14, r14, -CTX_BANCO_SIZE
  li r2, CTX_BANCO
  sw r2, 0(r14)
  li r3, g_pendente
  sw r14, 0(r3)           ; il banco 0 e' vivo, e questo e' il suo frame
  mov r1, r14
  li r5, g_handler
  lw r5, 0(r5)
  jr r5

; --- non era la sveglia: di nuovo nel banco 0, con la psw che la trap aveva
;     lasciato viva -- quella dell'interrotto senza IE. ctx_save legge da li'
;     i bit sporchi, e mtpsw li aveva azzerati ---
teb_torna:
  mfepsw r1
  srli r1, r1, 1
  slli r1, r1, 1          ; IE giu'
  mtpsw r1                ; ...e il banco dell'interrotto, che e' lo 0
teb_canonico:
  lw r1, -8(r14)
  j _trap_entry
.endif

; ==========================================================================
;  ctx_save: seconda meta' del salvataggio contesto (la prima e' il push raw di
;  r15 in _trap_entry, sopra). FOGLIA: non chiama nulla, quindi non tocca mai
;  r15 -> nessun salvataggio necessario per se stessa. Ritorna r1 = puntatore
;  al contesto opaco (la cima dell'intero frame).
; ==========================================================================
ctx_save:
  addi r14, r14, -4
  sw r1, 0(r14)
  addi r14, r14, -4
  sw r2, 0(r14)
  addi r14, r14, -4
  sw r3, 0(r14)
  addi r14, r14, -4
  sw r4, 0(r14)
  addi r14, r14, -4
  sw r5, 0(r14)
  addi r14, r14, -4
  sw r6, 0(r14)
  addi r14, r14, -4
  sw r7, 0(r14)
  addi r14, r14, -4
  sw r8, 0(r14)
  addi r14, r14, -4
  sw r9, 0(r14)
  addi r14, r14, -4
  sw r10, 0(r14)
  addi r14, r14, -4
  sw r11, 0(r14)
  addi r14, r14, -4
  sw r12, 0(r14)
  addi r14, r14, -4
  sw r13, 0(r14)
  mfepsw r1               ; r1 e' gia' in memoria: libero come scratch
  addi r14, r14, -4
  sw r1, 0(r14)           ; psw del task (IE=1: girava abilitato)
  mfepc r1
  addi r14, r14, -4
  sw r1, 0(r14)           ; epc

  ; ------------------------------------------------------------------------
  ;  L'ESTENSIONE -- float e vettori -- e SOLO cio' che il task ha toccato.
  ;
  ;  Salvarla sempre costerebbe ~1600 cicli a commutazione contro i ~120 dello
  ;  scalare -- un fattore dieci su OGNI commutazione, pagato anche dai task che
  ;  non la sfiorano. I due bit sporchi sono la domanda; il percorso di chi non
  ;  ne ha nessuno e' di quattro istruzioni, le stesse di quando il bit era uno.
  ;
  ;  I BLOCCHI SONO DUE dall'08/10/2026 (§3.86): i float (64 byte) e i vettori
  ;  (2060). Prima i float viaggiavano dentro il blocco vettoriale, e un task
  ;  solo float pagava i 2 KB dei vettori.
  ;
  ;  Il frame e' a TAGLIA VARIABILE, e la parola di flag e' l'ultima cosa
  ;  spinta -- cioe' quella all'indirizzo piu' basso, offset 0 del contesto
  ;  opaco. Deve stare li' perche' ctx_restore la legge PRIMA di sapere quanto
  ;  e' grande cio' che sta ripristinando. Il flag E' la maschera PSW_EXT della
  ;  psw: dice quali dei due blocchi stanno sotto.
  ;
  ;  I blocchi stanno sullo STACK del task e non nel TCB: il kernel vede TCB.sp
  ;  come un puntatore opaco e non lo interpreta mai (§12.3), e un campo nel TCB
  ;  gli farebbe conoscere una cosa che solo l'HAL sa leggere. Il prezzo lo paga
  ;  lo stack di chi usa l'estensione, che e' dove va pagato.
  ; ------------------------------------------------------------------------
  mfpsw r1
  li r2, PSW_EXT
  and r1, r1, r2           ; i bit sporchi del task: saranno il flag
  beq r1, r0, cs_clean
  mov r5, r1               ; r1..r13 sono gia' nel frame: tutti liberi

  ; --- i 16 registri FLOAT, se il task li ha scritti. Fino al 12/09 non erano
  ;     salvati MAI, e nessun commento lo dichiarava ---
  li r2, PSW_FDIRTY
  and r3, r5, r2
  beq r3, r0, cs_vett
  addi r14, r14, -4
  fsw f0, 0(r14)
  addi r14, r14, -4
  fsw f1, 0(r14)
  addi r14, r14, -4
  fsw f2, 0(r14)
  addi r14, r14, -4
  fsw f3, 0(r14)
  addi r14, r14, -4
  fsw f4, 0(r14)
  addi r14, r14, -4
  fsw f5, 0(r14)
  addi r14, r14, -4
  fsw f6, 0(r14)
  addi r14, r14, -4
  fsw f7, 0(r14)
  addi r14, r14, -4
  fsw f8, 0(r14)
  addi r14, r14, -4
  fsw f9, 0(r14)
  addi r14, r14, -4
  fsw f10, 0(r14)
  addi r14, r14, -4
  fsw f11, 0(r14)
  addi r14, r14, -4
  fsw f12, 0(r14)
  addi r14, r14, -4
  fsw f13, 0(r14)
  addi r14, r14, -4
  fsw f14, 0(r14)
  addi r14, r14, -4
  fsw f15, 0(r14)

  ; --- i VETTORIALI, se il task li ha scritti ---
cs_vett:
  li r2, PSW_VDIRTY
  and r3, r5, r2
  beq r3, r0, cs_flag

  ; --- vl e vmask PRIMA dei registri vettoriali: il salvataggio usa setvl, che
  ;     vl lo distrugge. vmask e' a 64 bit e la sw ne scrive 32: due parole ---
  mfvmask r1
  srli r2, r1, 32
  addi r14, r14, -4
  sw r2, 0(r14)           ; vmask, parte alta
  addi r14, r14, -4
  sw r1, 0(r14)           ; vmask, parte bassa (la sw tronca)
  mfvl r1
  addi r14, r14, -4
  sw r1, 0(r14)

  ; --- VLMAX non e' cablato: setvl restituisce min(richiesta, VLMAX), quindi
  ;     chiedere un numero assurdo E' il modo di farselo dire. Una costante qui
  ;     sarebbe una seconda dichiarazione di quella di vcpu.h ---
  li r3, 0x7fffffff
  setvl r3, r3
  slli r4, r3, 2          ; byte per registro vettoriale

  sub r14, r14, r4
  vstore v0, r14
  sub r14, r14, r4
  vstore v1, r14
  sub r14, r14, r4
  vstore v2, r14
  sub r14, r14, r4
  vstore v3, r14
  sub r14, r14, r4
  vstore v4, r14
  sub r14, r14, r4
  vstore v5, r14
  sub r14, r14, r4
  vstore v6, r14
  sub r14, r14, r4
  vstore v7, r14          ; v7 e' il piu' in basso: ctx_restore lo riprende per primo

cs_flag:
  addi r14, r14, -4
  sw r5, 0(r14)           ; flag = i bit sporchi: quali blocchi stanno sotto
  mov r1, r14
  ret

cs_clean:
  addi r14, r14, -4
  sw r0, 0(r14)           ; flag = 0, e r0 e' gia' zero
  mov r1, r14             ; r1 = puntatore al contesto opaco (per il chiamante)
  ret

; ==========================================================================
;  ctx_restore(r1 = puntatore al contesto da riprendere): ripristina i
;  registri e cede il controllo con reti. Speculare a ctx_save + al push raw
;  di r15 in _trap_entry. Non ritorna mai (nessun salvataggio di r15 propria).
; ==========================================================================
ctx_restore:
  mov r14, r1

  ; SOLO STRUMENTAZIONE: apre la finestra del ripristino.
  ;
  ; Questi cicli sono il pezzo che il KERNEL NON PUO' MISURARE: la sua finestra
  ; di latenza chiude prima di `call ctx_restore`, e da qui in poi non esiste
  ; piu' un'istruzione di kernel su cui appoggiare una chiusura -- questa
  ; routine non ritorna. Quindi l'HAL dichiara una categoria SUA e si misura da
  ; se': lo strato di sotto dice quanto costa, senza sapere cosa ne fa quello
  ; di sopra.
  ;
  ; r1 e' MORTO: e' appena stato copiato in r14 e la riga sotto lo ricarica.
  ; r2 e' del chiamante ed e' sporcato comunque da qui in giu'.
  DBG_OPEN MARK_HALSW, M_HALSW_LOAD

.ifdef BANCO
  ; ------------------------------------------------------------------------
  ;  IN QUALE BANCO SI RIPRISTINA (§3.86). Un frame si riprende nel banco
  ;  della SUA psw, e i due frame nuovi hanno una ripresa loro:
  ;
  ;    CTX_BANCO     l'interrotto della via veloce: i suoi registri sono
  ;                  ancora nel banco 0, basta reti
  ;    CTX_LEGGERO   il super task alla sua wait: epc e psw, e basta
  ;    canonico      se il banco del frame e' diverso da quello vivo si
  ;                  cambia -- e se si va nel banco 0 mentre un frame di banco
  ;                  e' in attesa (g_pendente), quel banco 0 e' VIVO: prima si
  ;                  MATERIALIZZA, cioe' si scrivono i suoi registri negli
  ;                  spazi che il frame di banco aveva riservato. Il puntatore
  ;                  non cambia, e il TCB che lo tiene resta valido
  ;
  ;  La materializzazione e' il caso raro: un altro task del banco 0 sceglie
  ;  di girare prima che l'interrotto riparta. La paga lui.
  ; ------------------------------------------------------------------------
  lw r1, 0(r14)
  li r2, CTX_BANCO
  beq r1, r2, cr_banco
  li r2, CTX_LEGGERO
  beq r1, r2, cr_leggero
  li r3, 8                ; la psw: dopo il flag, i blocchi e l'epc
  li r2, PSW_FDIRTY
  and r4, r1, r2
  beq r4, r0, crb_nof
  addi r3, r3, 64
crb_nof:
  li r2, PSW_VDIRTY
  and r4, r1, r2
  beq r4, r0, crb_nov
  addi r3, r3, 2060
crb_nov:
  add r3, r3, r14
  lw r3, 0(r3)            ; la psw del frame
  mfpsw r4
  xor r4, r4, r3
  slli r4, r4, 60         ; il banco della DIFFERENZA nel bit del segno
  blt r4, r0, crb_cambia
  j crb_comune
crb_cambia:
  slli r3, r3, 60
  blt r3, r0, crb_verso_alt
  li r2, g_pendente
  lw r2, 0(r2)
  beq r2, r0, crb_a_zero

  ; --- MATERIALIZZA il frame di banco in attesa (r2 = il suo puntatore) ---
  li r3, g_bersaglio
  sw r14, 0(r3)           ; il frame da riprendere, per dopo
  li r3, g_pendente
  sw r0, 0(r3)
  mov r14, r2
  mtpsw r0                ; banco 0: i registri dell'interrotto, vivi
  sw r2, 120(r14)         ; gli spazi del frame canonico coi float:
  sw r3, 116(r14)         ;   r_k a 76 + (13 - k) * 4
  sw r4, 112(r14)
  sw r5, 108(r14)
  sw r6, 104(r14)
  sw r7, 100(r14)
  sw r8, 96(r14)
  sw r9, 92(r14)
  sw r10, 88(r14)
  sw r11, 84(r14)
  sw r12, 80(r14)
  sw r13, 76(r14)
  sw r15, 128(r14)
  fsw f15, 4(r14)         ;   f_k a 4 + (15 - k) * 4
  fsw f14, 8(r14)
  fsw f13, 12(r14)
  fsw f12, 16(r14)
  fsw f11, 20(r14)
  fsw f10, 24(r14)
  fsw f9, 28(r14)
  fsw f8, 32(r14)
  fsw f7, 36(r14)
  fsw f6, 40(r14)
  fsw f5, 44(r14)
  fsw f4, 48(r14)
  fsw f3, 52(r14)
  fsw f2, 56(r14)
  fsw f1, 60(r14)
  fsw f0, 64(r14)
  li r2, PSW_FDIRTY
  sw r2, 0(r14)           ; adesso e' un frame canonico col blocco float
  li r2, g_bersaglio
  lw r14, 0(r2)
  j crb_comune
crb_a_zero:
  mtpsw r0                ; nel banco 0 non c'e' niente di vivo
  j crb_comune
crb_verso_alt:
  li r2, PSW_BANK
  mtpsw r2
crb_comune:
.endif

  lw r1, 0(r14)           ; il flag: quali blocchi dell'estensione stanno sotto?
  addi r14, r14, 4
  beq r1, r0, cr_scalar
  mov r5, r1              ; r1..r13 si ricaricano dal frame alla fine: liberi

  ; --- i VETTORIALI, che stanno piu' in basso: si riprendono per primi ---
  li r2, PSW_VDIRTY
  and r3, r5, r2
  beq r3, r0, cr_float

  li r3, 0x7fffffff
  setvl r3, r3            ; VL = VLMAX per ricaricare i registri PIENI
  slli r4, r3, 2

  vload v7, r14           ; in ordine inverso al salvataggio
  add r14, r14, r4
  vload v6, r14
  add r14, r14, r4
  vload v5, r14
  add r14, r14, r4
  vload v4, r14
  add r14, r14, r4
  vload v3, r14
  add r14, r14, r4
  vload v2, r14
  add r14, r14, r4
  vload v1, r14
  add r14, r14, r4
  vload v0, r14
  add r14, r14, r4

  lw r1, 0(r14)           ; vl del task: DOPO i vload, che lo avrebbero usato
  addi r14, r14, 4
  mtvl r1
  lw r1, 0(r14)           ; vmask, parte bassa -- la lw ESTENDE IL SEGNO,
  addi r14, r14, 4        ; quindi va ripulita prima di comporre
  slli r1, r1, 32
  srli r1, r1, 32
  lw r2, 0(r14)           ; vmask, parte alta
  addi r14, r14, 4
  slli r2, r2, 32
  or r1, r1, r2
  mtvmask r1

  ; --- i FLOAT ---
cr_float:
  li r2, PSW_FDIRTY
  and r3, r5, r2
  beq r3, r0, cr_scalar
  flw f15, 0(r14)
  addi r14, r14, 4
  flw f14, 0(r14)
  addi r14, r14, 4
  flw f13, 0(r14)
  addi r14, r14, 4
  flw f12, 0(r14)
  addi r14, r14, 4
  flw f11, 0(r14)
  addi r14, r14, 4
  flw f10, 0(r14)
  addi r14, r14, 4
  flw f9, 0(r14)
  addi r14, r14, 4
  flw f8, 0(r14)
  addi r14, r14, 4
  flw f7, 0(r14)
  addi r14, r14, 4
  flw f6, 0(r14)
  addi r14, r14, 4
  flw f5, 0(r14)
  addi r14, r14, 4
  flw f4, 0(r14)
  addi r14, r14, 4
  flw f3, 0(r14)
  addi r14, r14, 4
  flw f2, 0(r14)
  addi r14, r14, 4
  flw f1, 0(r14)
  addi r14, r14, 4
  flw f0, 0(r14)
  addi r14, r14, 4
  ; NB: mtvl, mtvmask e flw rialzano VDIRTY e FDIRTY nella psw VIVA, che reti
  ; sovrascrive con quella del frame. I bit che contano sono quelli, e ci sono:
  ; lo stato e' stato salvato proprio perche' erano alzati quando il task e'
  ; uscito.

cr_scalar:
  lw r1, 0(r14)           ; epc dal frame
  addi r14, r14, 4
  mtepc r1
  lw r1, 0(r14)           ; psw dal frame: il regime in cui il task riprende
  addi r14, r14, 4
  mtepsw r1
  lw r13, 0(r14)
  addi r14, r14, 4
  lw r12, 0(r14)
  addi r14, r14, 4
  lw r11, 0(r14)
  addi r14, r14, 4
  lw r10, 0(r14)
  addi r14, r14, 4
  lw r9, 0(r14)
  addi r14, r14, 4
  lw r8, 0(r14)
  addi r14, r14, 4
  lw r7, 0(r14)
  addi r14, r14, 4
  lw r6, 0(r14)
  addi r14, r14, 4
  lw r5, 0(r14)
  addi r14, r14, 4
  lw r4, 0(r14)
  addi r14, r14, 4
  lw r3, 0(r14)
  addi r14, r14, 4
  lw r2, 0(r14)
  addi r14, r14, 4

  lw r1, 0(r14)
  addi r14, r14, 4
  lw r15, 0(r14)
  addi r14, r14, 4

  ; SOLO STRUMENTAZIONE: chiude la finestra del ripristino, A RIDOSSO DELLA RETI.
  ;
  ; Qui NON C'E' UN REGISTRO LIBERO -- r1 e r15 portano gia' i valori del task,
  ; r14 e' il suo stack -- e con la forma li+li+sw questa chiusura era
  ; impossibile: stava sette istruzioni piu' su, e la finestra si chiudeva 11
  ; cicli prima che il task eseguisse. `mark` non tocca registri, ed e'
  ; esattamente per questo caso che e' stata aggiunta all'ISA (§3.66).
  ;
  ; RESTA FUORI UN CICLO: la `reti`. E' irriducibile dal software -- non esiste
  ; un'istruzione di kernel DOPO la consegna su cui appoggiare una marca --
  ; quindi si dichiara invece di inseguirlo.
  DBG_CLOSE MARK_HALSW

  reti                    ; pc = epc; psw = quella del frame -> il task riparte

.ifdef BANCO
; --- l'interrotto della via veloce: i registri sono ancora nel banco 0, e la
;     reti con la sua psw ce lo riporta ---
cr_banco:
  li r2, g_pendente
  sw r0, 0(r2)
  lw r1, 68(r14)
  mtepc r1
  lw r1, 72(r14)
  mtepsw r1
  lw r1, 124(r14)
  addi r14, r14, CTX_BANCO_SIZE
  reti

; --- il super task alla sua wait: niente registri, per la regola ---
cr_leggero:
  lw r1, 4(r14)
  mtepc r1
  lw r1, 8(r14)
  mtepsw r1
  addi r14, r14, 12
  reti
.endif

; ==========================================================================
;  hal_ctx_block(r1 = indirizzo di ripresa) -> r1 = contesto opaco
;
;  Il context switch SINCRONO: non lo provoca un'interruzione, lo chiede il task
;  stesso chiamando task_block (§8.8 della proposta). Nell'ISA non c'e' trap
;  software, quindi il frame va costruito a mano -- ma NON duplicando ctx_save,
;  che sono 26 push: duplicarli vorrebbe dire due copie del layout del frame da
;  tenere allineate, cioe' il difetto che §3.27 ha tolto dalle strutture.
;
;  La via e' che epc ed epsw sono SCRIVIBILI: si prepara cio' che ctx_save
;  trovera' e la si chiama INVARIATA. I due sostituti non sono un espediente --
;  senza istruzione interrotta l'epc E' un indirizzo di ritorno, e IE:1 discende
;  da §12.5 perche' si torna a un TASK (il caso che §12.5 dovette smontare era il
;  ritorno a codice di kernel, che qui non si da').
;
;  Scrivere i due CSR fuori da una trap e' sicuro perche' task_block gira con
;  IE = 0: nessuna trap puo' arrivare a usarli prima che siano consumati.
;
;  E' la SECONDA volta che mtepsw paga: aggiunto all'ISA il 05/09 per far
;  ritornare un'ISR a codice di kernel, serve di nuovo qui per un motivo diverso.
;
;  Il r15 che finisce nel frame e' il ritorno INTERNO a task_block, non quello
;  del task. Non importa e non va aggiustato: al risveglio ctx_restore lo
;  ripristina, ma reti atterra dentro receive, che il proprio r15 lo rilegge
;  dallo stack. Lo slot deve ESISTERE perche' il frame abbia la forma giusta.
; ==========================================================================
; ==========================================================================
;  hal_ctx_block_super(r1 = indirizzo di ripresa) -> r1 = contesto opaco
;
;  La sospensione del SUPER TASK (task_block_super). Nell'HAL normale e' un
;  secondo nome di hal_ctx_block -- lo stesso indirizzo, zero istruzioni. In
;  lib_hal_banco e' il frame LEGGERO (§3.86): attraverso la wait del super
;  task non si conserva niente, e il frame dice solo dove riprende e con quale
;  psw -- IE e il banco alternativo, SEMPRE: e' li' che il super task gira.
;  I bit sporchi no: cio' che c'era nei float e nei vettori e' morto.
; ==========================================================================
.ifdef BANCO
hal_ctx_block_super:
  addi r14, r14, -12
  sw r1, 4(r14)           ; epc: dove riprende
  li r2, PSW_IE_BANK
  sw r2, 8(r14)           ; psw
  li r2, CTX_LEGGERO
  sw r2, 0(r14)
  mov r1, r14
  ret
.else
hal_ctx_block_super:
.endif
hal_ctx_block:
  mtepc  r1               ; l'epc che ctx_save leggera': dove il task riprendera'
  ; --- la psw con cui il task riprendera': IE:1 sempre, e i BIT SPORCHI COME
  ;     ADESSO ---
  ; Qui la epsw si COSTRUISCE invece di copiarla (non c'e' stata nessuna trap a
  ; scriverla), e questo e' il punto in cui VDIRTY e FDIRTY andrebbero persi: un
  ; task che si blocca volontariamente riprenderebbe con i bit bassi, e alla
  ; preemption successiva il suo stato non verrebbe salvato. Tre istruzioni per
  ; non perderli, le stesse di quando il bit era uno.
  mfpsw  r3
  li     r2, PSW_EXT
  and    r3, r3, r2
  li     r2, PSW_IE
  or     r2, r2, r3
  mtepsw r2
  addi r14, r14, -4
  sw r15, 0(r14)          ; slot r15 del frame, come _trap_entry
  ; --- j e non call, ed e' una semplificazione oltre che un obbligo ---
  ; Saltando, r15 NON viene distrutto: il ret di ctx_save torna direttamente al
  ; chiamante nostro, con r1 = contesto opaco gia' pronto. Prima qui c'era una
  ; call seguita da "lw r15, 60(r1)" per recuperare il proprio ritorno dallo
  ; slot del frame -- un offset cablato che con il frame a taglia VARIABILE
  ; (§ctx_save) non sarebbe piu' stato costante. La coda-chiamata lo toglie di
  ; mezzo invece di renderlo condizionale.
  j ctx_save

; ==========================================================================
;  ctx_init(r1 = cima dello stack, r2 = entry del task) -> r1 = sp iniziale.
;  Clobber: r3.
;  Costruisce un frame FINTO col layout di _trap_entry: epc = entry, psw con
;  IE=1, i registri restano 0 (lo stack e' memoria azzerata). Al primo switch-in
;  il task parte via reti come se fosse stato preemptato. E'
;  pxPortInitialiseStack di FreeRTOS.
;
;  LA psw VA SCRITTA ESPLICITAMENTE, e non e' un dettaglio: da quando
;  ctx_restore la ripristina dal frame (mtepsw), uno slot lasciato a zero
;  farebbe partire il task con IE=0 — e un task che gira a interrupt disabilitati
;  non viene mai preemptato. Prima non serviva perche' il regime era uniforme e
;  arrivava dalla epsw lasciata dalla trap precedente.
; ==========================================================================
ctx_init:
  addi r1, r1, -CTX_FRAME_SIZE  ; base del frame (offset 0 = flag vettoriale)
  sw r0, 0(r1)            ; flag = 0: un task NASCE senza stato vettoriale, e
                          ; lo stack e' gia' azzerato -- la riga c'e' perche' il
                          ; layout si legga qui invece che dedurlo
  sw r2, 4(r1)            ; epc = entry
  li r3, PSW_IE
  sw r3, 8(r1)            ; psw = IE:1, il task parte interrompibile
  ret

; ==========================================================================
;  Primitivi hardware del timer e degli interrupt, per il boot del sistema.
; ==========================================================================
timer_init:               ; timer_init(r1 = periodo in cicli): arma il tick
  settimer r1
  ret

irq_arm:                  ; installa il vettore di trap dell'HAL
  sethandler _trap_entry
  ret

.ifdef BANCO
; irq_arm_banco(r1 = la causa che sveglia il super task): il vettore con la via
; veloce. La causa e' un dato dell'applicazione -- l'HAL non sa quale sorgente
; scandisca la time line -- e passa per registrazione, come l'ISR con
; irq_install. Clobber: r2.
irq_arm_banco:
  li r2, g_causa_banco
  sw r1, 0(r2)
  sethandler _trap_entry_banco
  ret
.endif

; irq_install(r1 = puntatore all'ISR applicativa): la registra. L'app lo ottiene
; con `li rX, la_mia_isr` (R_ADDR -> indice d'istruzione = puntatore a funzione).
; Clobber: r2.
irq_install:
  li r2, g_handler
  sw r1, 0(r2)
  ret

irq_enable:               ; abilita gli interrupt (IE = 1)
  sti
  ret

; ==========================================================================
;  Sezione critica su monoprocessore = disabilitare gli interrupt. Coppia
;  SAVE/RESTORE (non cli/sti secco) per COMPONIBILITA': ripristina lo stato
;  PRECEDENTE, quindi resta corretta anche annidata o con IE gia' 0. La parola
;  di stato viaggia in r5: l'HAL non tocca r1/r2, cosi' un wrapper puo'
;  racchiudere una raw di coda senza disturbarne gli argomenti.
; ==========================================================================
irq_save:                 ; irq_save() -> r5 = psw precedente; poi IE = 0
  mfpsw r5
  cli
  ret

irq_restore:              ; irq_restore(r5 = psw da ripristinare)
  mtpsw r5
  ret
