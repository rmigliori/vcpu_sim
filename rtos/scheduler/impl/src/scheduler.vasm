; kernel/scheduler.vasm — KERNEL PURO: politica round-robin + meccanismo di coda.
; Nessun accesso all'hardware: i CSR delle eccezioni (mfepc/mtepc/reti), il
; vettore di trap, ctx_save/ctx_restore e il timer stanno nell'HAL
; (hal/machine.vasm). Il kernel vede il contesto salvato di un task come un
; PUNTATORE OPACO (sp) e non lo interpreta mai.
;
; Modello IRQ-STUB a preemption DIFFERITA (need_resched di Linux /
; xHigherPriorityTaskWoken di FreeRTOS). Dal 05/09/2026 (§12.2 della proposta)
; il kernel NON e' piu' chiamato dall'HAL: il vettore consegna il controllo
; all'ISR applicativa, e l'ISR — che e' cliente sia dell'HAL sia del kernel —
; entra qui quando ha finito, saltando a sched_isr_exit. Prima l'HAL chiamava
; sched_dispatch, che invocava lei l'ISR: il kernel stava in mezzo, e da li'
; veniva la dipendenza HAL -> kernel che ora non esiste piu'.
;
; Tre routine, tre responsabilita' nette (nessuna mischia le altre due):
;   sched_isr_exit  uscita da ISR  registra il contesto uscente nel TCB, decide
;                                  se consultare lo scheduler, chiama SEMPRE il
;                                  dispatcher
;   scheduler       POLITICA       chi e' il prossimo: round-robin. RESTITUISCE
;                                  un TCB, non lo mette in esecuzione
;   dispatcher      MECCANISMO     riceve un TCB IN INPUT, fa il commit di
;                                  'current' e chiama l'HAL (ctx_restore); non
;                                  ritorna mai
;
; sched_isr_exit e scheduler non sono API generiche (non le chiama "chiunque"):
; hanno un solo chiamante per costruzione, quindi restano scritte a mano invece
; che con la sugar .proc/.endproc — riservata a procedure con un contratto
; stabile e riusabile.
;
; Separazione mechanism/policy: si cambia politica (RR -> priorita') riscrivendo
; solo scheduler, senza toccare l'HAL, sched_isr_exit ne' dispatcher.
;
; --- Modello a 3 stati (una posizione fisica del TCB per ogni stato) ---
;   READY(0)     : il TCB e' linkato nella ready queue.
;   RUNNING(1)   : il TCB e' FUORI da ogni coda, puntato solo da 'current'.
;   SUSPENDED(2) : il TCB e' in una coda di semaforo/mailbox (estensione futura).
;
; --- TCB (16 byte):  +0 fwd  +4 bwd  +8 sp_salvato  +12 stato ---
;   sp_salvato = il puntatore-a-contesto opaco fornito dall'HAL.

; Tipi comuni (TESTA, TCB, stati) condivisi con l'app: single source of truth.
.include "tcb/tcb.vinc"
.include "coda/coda_api.vinc"

  .data

  .global pcb0
  .global pcb1
  .global pcb2
  .global pcb3
  .global pcb4
  .global pcb5
  .global pcb6
  .global pcb7
  .global current

; --------------------------------------------------------------------------
;  LA TABELLA DEI PCB — otto livelli, 0 il piu' prioritario (§4).
;
;  Scritti uno per uno e NON con una .space: l'ordine di dichiarazione non e' un
;  dettaglio di scrittura, e' l'INVARIANTE PORTANTE di §7.3. TCB.pcb contiene un
;  indirizzo, non un indice, e i confronti di priorita' si fanno con una blt sui
;  puntatori: funziona solo perche' la tabella e' contigua e in ordine, quindi
;  l'indirizzo cresce al CALARE della priorita'. Otto righe consecutive rendono
;  quell'ordine leggibile; una .space lo nasconderebbe dentro un'aritmetica.
;
;  Chi un domani ne inserisce uno in mezzo o li riordina rompe TUTTI i confronti
;  senza che niente lo segnali: e' il difetto che si manifesta come inversione di
;  priorita' sporadica sei mesi dopo (§7.3).
;
;  Nessuno di questi nasce inizializzato: una TESTA vuota ha fwd = bwd = &se
;  stessa, che un .word non puo' scrivere perche' non accetta etichette. Ci
;  pensa sched_init, ed e' il motivo per cui §6 ("strutture gia' inizializzate
;  staticamente al link") non e' mai stata del tutto vera -- gia' oggi la vecchia
;  'ready' passava da coda_init.
; --------------------------------------------------------------------------
pcb0:      .res PCB       ; PRIO_MAX — il gestore dei timeout (§9.2)
pcb1:      .res PCB
pcb2:      .res PCB
pcb3:      .res PCB
pcb4:      .res PCB
pcb5:      .res PCB
pcb6:      .res PCB
pcb7:      .res PCB       ; PRIO_IDLE — l'idle, che non si blocca mai

current:   .word 0        ; &TCB del task RUNNING (0 = nessuno, boot)
g_resched: .word 0        ; need_resched: !=0 => switch a uscita IRQ

  .text

  .global sched_isr_exit
  .global request_preempt
  .global sched_init
  .extern ctx_restore

; ==========================================================================
;  sched_init(): svuota le otto code di ready e i loro slot.
;
;  Esiste perche' una TESTA vuota non e' fatta di zeri (fwd = bwd = &se stessa),
;  quindi il .data non puo' produrla. Lo slot invece nasce corretto a zero, ma
;  azzerarlo esplicitamente costa un'istruzione e rende il codice leggibile
;  senza sapere com'e' fatto il segmento dati.
;
;  Cicla sulla tabella per indirizzo -- da pcb0 fino a oltre pcb7 -- il che vale
;  come verifica implicita dell'invariante di §7.3: se i PCB non fossero
;  contigui e in ordine, questo ciclo non li toccherebbe tutti.
;
;  Non-foglia (chiama coda_init), corpo con salti -> prologo a mano.
; ==========================================================================
sched_init:
  addi r14, r14, -4
  sw r15, 0(r14)
  li r5, pcb0            ; r5 = PCB corrente
  li r6, pcb7            ; r6 = ultimo: il ciclo si ferma DOPO averlo fatto
sched_init_loop:
  mov r1, r5
  call coda_init         ; &pcb == &pcb.coda: nessuna conversione (§7.5)
  sw r0, PCB.preemptato(r5)
  beq r5, r6, sched_init_done
  addi r5, r5, PCB.size
  j sched_init_loop
sched_init_done:
  lw r15, 0(r14)
  addi r14, r14, 4
  ret

; ==========================================================================
;  request_preempt: arma il need_resched. Chiamata dall'handler quando vuole uno
;  switch; un handler che NON la chiama => nessuna preemption (scelta dell'app).
;  Clobber: r1, r2.
; ==========================================================================
request_preempt:
  li r1, g_resched
  li r2, 1
  sw r2, 0(r1)
  ret

; ==========================================================================
;  sched_isr_exit(r1 = contesto opaco del task interrotto): USCITA DA UN'ISR.
;  Ci salta l'ISR applicativa quando ha finito, e non ritorna mai.
;
;  Sostituisce sched_dispatch (§12.2 della proposta). La differenza non e' il
;  nome: sched_dispatch veniva chiamata DALL'HAL e invocava lei l'ISR, mettendo
;  il kernel in mezzo fra il vettore e il codice applicativo. Ora il vettore
;  consegna direttamente all'ISR, e il kernel torna in gioco solo quando l'ISR
;  glielo chiede — che e' cio' che rende l'ISR cliente di HAL e kernel invece
;  che una callback del kernel.
;
;  Registra il contesto uscente nel TCB corrente (l'ISR non tocca il TCB: non e'
;  affar suo dove finisce il contesto), poi, SOLO se l'ISR ha chiesto una
;  preemption, consulta lo scheduler. Chiama SEMPRE il dispatcher: con o senza
;  switch e' l'unico modo di uscire dalla trap.
;
;  Non ha un ritorno proprio (il dispatcher, in coda, chiude nell'HAL con
;  ctx_restore/reti): niente da salvare per se stessa, anche se non-foglia.
;  Non tocca alcun CSR: il kernel resta puro.
; ==========================================================================
sched_isr_exit:
  li r2, current
  lw r3, 0(r2)
  sw r1, TCB.sp(r3)      ; current.sp = contesto uscente (opaco)
  mov r1, r3             ; r1 = TCB per il dispatcher. Il DEFAULT e' l'uscente,
                         ; ed e' la forma esatta di "senza preemption riprende
                         ; chi girava": senza switch nessuno sceglie niente,
                         ; quindi non e' lo scheduler a doverlo dire

  li r2, g_resched
  lw r4, 0(r2)
  beq r4, r0, sched_isr_exit_done
  sw r0, 0(r2)           ; consuma il need_resched
  call scheduler         ; POLITICA: sceglie il prossimo -> r1 = TCB scelto
sched_isr_exit_done:
  call dispatcher        ; MECCANISMO: mette in esecuzione r1, SEMPRE

; ==========================================================================
;  scheduler (POLITICA, interno) -> r1 = TCB scelto: PRIORITA' STATICHE con PCB
;  (§3, §4). Mette via l'uscente e sceglie il prossimo. Non e' un'API generica
;  (un solo chiamante: sched_isr_exit) -> scritta a mano, non .proc. Non-foglia.
;
;  Dal 07/09/2026 non e' piu' round-robin a coda singola, ed e' il passaggio che
;  la separazione mechanism/policy prometteva: HAL, sched_isr_exit e dispatcher
;  NON sono stati toccati. Cambia solo questa routine e le strutture che legge.
;
;  Due meta', e la prima e' quella che porta il peso del modello (§2): dove va
;  l'uscente lo decide chi lo toglie dalla CPU, non chi sceglie il prossimo.
;
;  NON scrive 'current' e NON scrive lo stato del task scelto: RESTITUISCE un
;  TCB, e il commit e' del dispatcher (§12.3). E' la differenza fra applicare una
;  politica e mettere in esecuzione — finche' scriveva 'current' faceva tutte e
;  due, e il confine fra i due algoritmi era una convenzione invece che
;  un'interfaccia. Quello che resta qui e' politica pura: dove va l'uscente
;  (round-robin: in fondo) e chi e' il prossimo.
; ==========================================================================
scheduler:
  addi r14, r14, -4
  sw r15, 0(r14)         ; non-foglia: preserva il ritorno a sched_isr_exit

  ; --- 1. l'uscente va nel SUO slot, non in fondo a una coda (§2) ---
  ; Ha lasciato la CPU controvoglia -- e' arrivato un tick, non ha ceduto lui --
  ; quindi riprendera' da dove stava e non paga un'interruzione che non ha
  ; chiesto. Lo slot e' per livello, e "al massimo un task per livello puo'
  ; essere a meta' esecuzione" e' garantito dalla preferenza slot-su-coda del
  ; punto 2: finche' lo slot e' pieno, dalla coda di quel livello non esce
  ; nessuno (§4).
  li r6, current
  lw r4, 0(r6)           ; r4 = TCB uscente
  lw r5, TCB.pcb(r4)     ; r5 = il suo PCB (un indirizzo, non un indice: §7.3)
  sw r4, PCB.preemptato(r5)
  li r3, PREEMPTED
  sw r3, TCB.state(r4)

  ; --- 2. scansione dall'alto: a ogni livello lo slot batte la coda (§4) ---
  ; Il PCB corrente sta in r7 e NON in uno scratch: dequeue_testa sporca r2, r4
  ; e r5 (lo dichiara coda_api.vinc), quindi tenerlo in r5 lo farebbe avanzare
  ; da un indirizzo spazzatura dalla seconda iterazione in poi. E' un bug che
  ; non si vede su un solo livello: lo scan si ferma sempre al primo giro finche'
  ; c'e' un preemptato in cima.
  li r7, pcb0            ; si parte da 0, che e' la priorita' PIU' ALTA
sched_scan:
  lw r1, PCB.preemptato(r7)
  beq r1, r0, sched_scan_coda
  sw r0, PCB.preemptato(r7)  ; lo slot si svuota: quel task torna a girare
  j sched_scan_done
sched_scan_coda:
  mov r1, r7             ; &pcb == &pcb.coda (§7.5 un livello sopra)
  call dequeue_testa     ; r2 = TCB, 0 se il livello e' vuoto
  mov r1, r2
  bne r1, r0, sched_scan_done
  addi r7, r7, PCB.size  ; livello successivo, cioe' meno prioritario
  j sched_scan
sched_scan_done:
  ; La scansione TERMINA SEMPRE e non ha il caso "nessuno eseguibile": l'idle
  ; sta a PRIO_IDLE e non si blocca mai, quindi l'ultimo livello e' pronto per
  ; costruzione (§4). Se un giorno lo fosse, si uscirebbe da qui oltre pcb7 con
  ; r1 = 0 -- ed e' un errore di costruzione del sistema, non un caso da gestire.
  lw r15, 0(r14)
  addi r14, r14, 4
  ret                    ; r1 = TCB scelto

; ==========================================================================
;  dispatcher(r1 = &TCB) (MECCANISMO puro, interno): mette in esecuzione il task
;  che riceve IN INPUT, switch o no — chiama l'HAL (ctx_restore) e non sa ne'
;  vuole sapere come sono fatti i registri. Non ritorna mai (ctx_restore chiude
;  con reti): niente da salvare. Non e' un'API generica (un solo chiamante:
;  sched_isr_exit) -> scritto a mano.
;
;  L'INPUT ESPLICITO e' §12.3, e ha chiuso il debito che stava scritto qui.
;  Prima il TCB passava fra i due algoritmi attraverso 'current': lo scheduler
;  ce l'aveva in un registro, lo scriveva in memoria, e due istruzioni dopo il
;  dispatcher lo rileggeva. Il confine non era un'interfaccia, era una
;  convenzione — e finche' era cosi' il terzo ritorno da un'ISR (§12.4, "salta
;  al dispatcher perche' la scelta e' gia' fatta") non era nemmeno esprimibile:
;  non c'era un posto dove mettere il TCB.
;
;  Ed e' QUI che si scrivono 'current' e lo stato RUNNING, non nella politica:
;  il dispatcher e' l'unico punto da cui un task entra in esecuzione, quindi e'
;  l'unico che possa dichiararlo. Sul percorso senza preemption la scrittura e'
;  idempotente (current gia' puntava li', lo stato era gia' RUNNING) e costa due
;  istruzioni: si paga perche' l'invariante "current lo scrive solo il
;  dispatcher" vale piu' di due istruzioni per tick — e' cio' che rende vero,
;  invece che sperato, che nessun altro possa mettere in esecuzione un task.
; ==========================================================================
dispatcher:
  li r2, current
  sw r1, 0(r2)           ; COMMIT: current = il TCB che sta per girare
  li r3, RUNNING
  sw r3, TCB.state(r1)   ; ... ed e' RUNNING per definizione di dispatcher
  lw r1, TCB.sp(r1)      ; r1 = contesto opaco da riprendere
  call ctx_restore       ; HAL: ripristina i registri e cede il controllo
