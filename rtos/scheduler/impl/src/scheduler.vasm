; kernel/scheduler.vasm — KERNEL PURO: politica round-robin + meccanismo di coda.
; Nessun accesso all'hardware: i CSR delle eccezioni (mfepc/mtepc/reti), il
; vettore di trap, ctx_save/ctx_restore e il timer stanno nell'HAL
; (hal/machine.vasm). Il kernel vede il contesto salvato di un task come un
; PUNTATORE OPACO (sp) e non lo interpreta mai.
;
; Modello IRQ-STUB a preemption DIFFERITA (need_resched di Linux /
; xHigherPriorityTaskWoken di FreeRTOS). Dal 05/09/2026 (§12.2 della proposta)
; il kernel NON e' piu' chiamato dall'HAL: il vettore consegna il controllo
; all'ISR applicativa, e l'ISR — che e' cliente sia dell'HAL sia del kernel —
; entra qui quando ha finito, saltando a sched_isr_exit. Prima l'HAL chiamava
; sched_dispatch, che invocava lei l'ISR: il kernel stava in mezzo, e da li'
; veniva la dipendenza HAL -> kernel che ora non esiste piu'.
;
; Tre routine, tre responsabilita' nette (nessuna mischia le altre due):
;   sched_isr_exit  uscita da ISR  registra il contesto uscente nel TCB, decide
;                                  se consultare lo scheduler, chiama SEMPRE il
;                                  dispatcher
;   scheduler       POLITICA       chi e' il prossimo: round-robin. RESTITUISCE
;                                  un TCB, non lo mette in esecuzione
;   dispatcher      MECCANISMO     riceve un TCB IN INPUT, fa il commit di
;                                  'current' e chiama l'HAL (ctx_restore); non
;                                  ritorna mai
;
; sched_isr_exit e scheduler non sono API generiche (non le chiama "chiunque"):
; hanno un solo chiamante per costruzione, quindi restano scritte a mano invece
; che con la sugar .proc/.endproc — riservata a procedure con un contratto
; stabile e riusabile.
;
; Separazione mechanism/policy: si cambia politica (RR -> priorita') riscrivendo
; solo scheduler, senza toccare l'HAL, sched_isr_exit ne' dispatcher.
;
; --- Modello a 3 stati (una posizione fisica del TCB per ogni stato) ---
;   READY(0)     : il TCB e' linkato nella ready queue.
;   RUNNING(1)   : il TCB e' FUORI da ogni coda, puntato solo da 'current'.
;   SUSPENDED(2) : il TCB e' in una coda di semaforo/mailbox (estensione futura).
;
; --- TCB (16 byte):  +0 fwd  +4 bwd  +8 sp_salvato  +12 stato ---
;   sp_salvato = il puntatore-a-contesto opaco fornito dall'HAL.

; Tipi comuni (HEAD, TCB, stati) condivisi con l'app: single source of truth.
.include "tcb/tcb.vinc"
.include "queue/queue_api.vinc"

  .data

  .global pcb0
  .global pcb1
  .global pcb2
  .global pcb3
  .global pcb4
  .global pcb5
  .global pcb6
  .global pcb7
  .global current

; --------------------------------------------------------------------------
;  LA TABELLA DEI PCB — otto livelli, 0 il piu' prioritario (§4).
;
;  Scritti uno per uno e NON con una .space: l'ordine di dichiarazione non e' un
;  dettaglio di scrittura, e' l'INVARIANTE PORTANTE di §7.3. TCB.pcb contiene un
;  indirizzo, non un indice, e i confronti di priorita' si fanno con una blt sui
;  puntatori: funziona solo perche' la tabella e' contigua e in ordine, quindi
;  l'indirizzo cresce al CALARE della priorita'. Otto righe consecutive rendono
;  quell'ordine leggibile; una .space lo nasconderebbe dentro un'aritmetica.
;
;  Chi un domani ne inserisce uno in mezzo o li riordina rompe TUTTI i confronti
;  senza che niente lo segnali: e' il difetto che si manifesta come inversione di
;  priorita' sporadica sei mesi dopo (§7.3).
;
;  Nessuno di questi nasce inizializzato: una HEAD vuota ha fwd = bwd = &se
;  stessa, che un .word non puo' scrivere perche' non accetta etichette. Ci
;  pensa sched_init, ed e' il motivo per cui §6 ("strutture gia' inizializzate
;  staticamente al link") non e' mai stata del tutto vera -- gia' oggi la vecchia
;  'ready' passava da queue_init.
; --------------------------------------------------------------------------
pcb0:      .res PCB       ; PRIO_MAX — il gestore dei timeout (§9.2)
pcb1:      .res PCB
pcb2:      .res PCB
pcb3:      .res PCB
pcb4:      .res PCB
pcb5:      .res PCB
pcb6:      .res PCB
pcb7:      .res PCB       ; PRIO_IDLE — l'idle, che non si blocca mai

current:   .word 0        ; &TCB del task RUNNING (0 = nessuno, boot)
g_resched: .word 0        ; need_resched: !=0 => switch a uscita IRQ

  .text

  .global sched_isr_exit
  .global request_preempt
  .global sched_init
  .global task_block
  .global task_yield
  .global task_ready
  .global prio_pcb
  .global sched_ready_above
  .extern ctx_restore
  .extern hal_ctx_block

; ==========================================================================
;  sched_init(): svuota le otto code di ready e i loro slot.
;
;  Esiste perche' una HEAD vuota non e' fatta di zeri (fwd = bwd = &se stessa),
;  quindi il .data non puo' produrla. Lo slot invece nasce corretto a zero, ma
;  azzerarlo esplicitamente costa un'istruzione e rende il codice leggibile
;  senza sapere com'e' fatto il segmento dati.
;
;  Cicla sulla tabella per indirizzo -- da pcb0 fino a oltre pcb7 -- il che vale
;  come verifica implicita dell'invariante di §7.3: se i PCB non fossero
;  contigui e in ordine, questo ciclo non li toccherebbe tutti.
;
;  Non-foglia (chiama queue_init), corpo con salti -> prologo a mano.
; ==========================================================================
sched_init:
  addi r14, r14, -4
  sw r15, 0(r14)
  li r5, pcb0            ; r5 = PCB corrente
  li r6, pcb7            ; r6 = ultimo: il ciclo si ferma DOPO averlo fatto
sched_init_loop:
  mov r1, r5
  call queue_init         ; &pcb == &pcb.coda: nessuna conversione (§7.5)
  sw r0, PCB.preempted(r5)
  beq r5, r6, sched_init_done
  addi r5, r5, PCB.size
  j sched_init_loop
sched_init_done:
  lw r15, 0(r14)
  addi r14, r14, 4
  ret

; ==========================================================================
;  task_block(): cede la CPU e non ritorna finche' task_ready non risveglia il
;  chiamante. E' il contratto che messageHandling.vasm dichiara da giorni come
;  .extern, e il PERCORSO VOLONTARIO che §12.6 lasciava come ultimo aperto.
;
;  PRECONDIZIONE, e non e' verificabile da qui: il chiamante si e' GIA' accodato
;  dove verra' ritrovato (la propria mailbox, la coda di un semaforo). Per questo
;  qui non si accoda niente e non si tocca PCB.preempted: il TCB e' gia' in una
;  lista, e metterlo anche nello slot lo renderebbe eseguibile pur essendo in
;  attesa -- due posizioni per una coppia di link sola (§7.5).
;
;  L'indirizzo di ripresa e' il NOSTRO r15, cioe' il ritorno al chiamante, e va
;  passato esplicitamente: dentro hal_ctx_block r15 sara' gia' un altro (§8.8).
;
;  Non ritorna per la via normale: cade nel dispatcher, che chiude nell'HAL con
;  ctx_restore/reti. Il ritorno vero avviene molto dopo, quando lo scheduler
;  riscegliera' questo TCB e reti atterrera' all'indirizzo che abbiamo salvato.
; ==========================================================================
task_block:
  mov r1, r15            ; l'indirizzo di ripresa: il ritorno al chiamante
  call hal_ctx_block     ; r1 = contesto opaco del chiamante
  li r2, current
  lw r3, 0(r2)
  sw r1, TCB.sp(r3)      ; il contesto vive nel TCB, come dopo una trap
  li r4, SUSPENDED
  sw r4, TCB.state(r3)
  call scheduler         ; la scelta va rifatta (§12.4 caso 2), IE e' gia' 0
  j dispatcher           ; e da li' non si torna

; ==========================================================================
;  task_yield(): CEDE IL TURNO RESTANDO ESEGUIBILE. Ritorna al chiamante quando
;  lo scheduler lo risceglie, senza che nessuno debba risvegliarlo.
;
;  E' il gemello di task_block, e la differenza sta in DUE righe: lo stato resta
;  READY e il TCB va in fondo alla coda del PROPRIO livello invece di restare
;  dove il chiamante si era accodato. Da cui la proprieta' che rende questa
;  primitiva diversa da tutte le altre uscite:
;
;      CHI CEDE NON LASCIA MAI IL PROPRIO LIVELLO.
;
;  E' la ragione per cui e' l'unica uscita volontaria che l'IDLE puo' usare. §4
;  fa poggiare la terminazione della scansione su "l'ultimo livello non e' mai
;  vuoto" (vedi sched_scan_done, che dichiara il caso contrario un errore di
;  costruzione del sistema e non un ramo da scrivere): un idle che si BLOCCA lo
;  svuota, un idle che CEDE no -- il suo TCB e' in PCB.queue, che e' esattamente
;  dove la scansione lo cerchera'.
;
;  --- PERCHE' ESISTE: §13.7, E DUE CLIENTI INDIPENDENTI ---
;
;  §13.7 dice che mutex_unlock e' un punto di preemption e prescrive di armare
;  request_preempt lasciando decidere "al percorso di uscita". Da contesto di
;  TASK quel percorso non c'e': l'unico consumatore di g_resched e'
;  sched_isr_exit, quindi il flag resta armato fino al tick successivo e la
;  latenza diventa il periodo del timer invece della lunghezza della sezione
;  critica. Il buco si chiude con un rientro sincrono che NON sospende, ed e'
;  questo -- §13.7 lo descrive alla lettera: "le stesse otto righe di task_block
;  con enqueue_tail al posto di SUSPENDED".
;
;  Il secondo cliente e' arrivato da un'altra porta (rtos/test/test_events.vasm):
;  un lettore in polling che, senza interrupt, e' per costruzione l'idle, e che
;  dopo aver consegnato quello che ha letto deve cedere. Due clienti che non si
;  conoscono sono la ragione per cui questa e' una primitiva del kernel e non un
;  idiom da ripetere nelle applicazioni.
;
;  --- CONSUMA IL need_resched, E NON E' UN DI PIU' ---
;  Questa primitiva ESISTE per essere il consumatore sincrono che §13.7 dice
;  mancante: uno switch che ignorasse il flag che e' nato per onorare sarebbe una
;  contraddizione, e lascerebbe al tick successivo una rotazione gia' fatta.
;  Nota l'asimmetria con task_block, che NON lo consuma: anche li' il flag resta
;  stantio dopo uno switch, ed e' un'osservazione aperta -- non la tocco qui
;  perche' quel percorso e' verificato da cinque test e la cosa va decisa a
;  parte, non di rimbalzo.
;
;  --- CEDERE DENTRO UNA SEZIONE CRITICA E' LECITO, E VA SAPUTO ---
;  Non si guarda TCB.crit, e la differenza con sp_mio_livello e' sostanziale:
;  li' il kernel toglieva il turno a qualcuno CONTRO la sua volonta' (§13.2,
;  "chi e' in sezione critica non si ruota"), qui e' il possessore stesso a
;  chiederlo. E' la SECONDA causa di §13.5 -- il possessore che cede o si blocca
;  dentro la sezione critica -- e resta quello che §13.5 dice che sia: un modo
;  documentato di far popolare una coda che sotto un ceiling corretto sarebbe
;  vuota, non un difetto da impedire qui dentro.
;
;  L'indirizzo di ripresa e' il NOSTRO r15, come in task_block: dentro
;  hal_ctx_block r15 sara' gia' un altro (§8.8).
;
;  Il prezzo, dichiarato: cedere quando non c'e' nessun altro eseguibile costa
;  comunque un ctx_save + una scansione + un ctx_restore, e ritrova se stessi.
;  Non c'e' il ramo "sp_solo" della rotazione, perche' per averlo bisognerebbe
;  scandire PRIMA di salvare il contesto, cioe' scandire due volte nel caso che
;  conta. Chi cede sa di star pagando uno switch.
; ==========================================================================
task_yield:
  mov r1, r15            ; l'indirizzo di ripresa: il ritorno al chiamante
  call hal_ctx_block     ; r1 = contesto opaco del chiamante
  li r2, current
  lw r3, 0(r2)
  sw r1, TCB.sp(r3)      ; il contesto vive nel TCB, come dopo una trap
  sw r0, TCB.state(r3)   ; READY: e' QUI la differenza da task_block
  lw r1, TCB.pcb(r3)     ; &pcb == &pcb.coda: nessuna conversione (§7.5)
  mov r2, r3
  call enqueue_tail      ; in FONDO al mio livello: cedere e' passare per ultimo
  li r1, g_resched
  sw r0, 0(r1)           ; la preemption chiesta la sto onorando io
  call scheduler         ; la scelta va rifatta, IE e' gia' 0
  j dispatcher           ; e da li' non si torna

; ==========================================================================
;  task_ready(r1 = &TCB): rende eseguibile un task e valuta la preemption.
;
;  Le due meta' sono separate di proposito: accodare e' meccanismo, chiedere la
;  preemption e' politica -- e la politica qui e' una riga sola, perche' la
;  convenzione di §4 (0 = piu' alta) e l'invariante di §7.3 (tabella dei PCB in
;  ordine) rendono il confronto fra priorita' una blt SUI PUNTATORI. Nessun
;  indice da convertire, nessun numero da leggere: il PCB del risvegliato sta a
;  un indirizzo piu' basso di quello di current se e solo se e' piu' prioritario.
;
;  NON commuta: arma il flag e lascia decidere al percorso di uscita (§6). Vale
;  anche quando la chiama un'ISR, ed e' il motivo per cui esiste request_preempt.
; ==========================================================================
task_ready:
  addi r14, r14, -4
  sw r15, 0(r14)
  mov r2, r1             ; r2 = il nodo da accodare
  lw r7, TCB.pcb(r2)     ; r7 = il suo PCB. Sopravvive alle call (r4/r5 no)
  sw r0, TCB.state(r2)   ; READY
  mov r1, r7             ; &pcb == &pcb.coda: nessuna conversione (§7.5)
  call enqueue_tail
  li r2, current
  lw r2, 0(r2)
  lw r3, TCB.pcb(r2)     ; il PCB di chi sta girando
  blt r7, r3, task_ready_preempt   ; indirizzo minore = piu' prioritario (§4)
  lw r15, 0(r14)
  addi r14, r14, 4
  ret
task_ready_preempt:
  call request_preempt
  lw r15, 0(r14)
  addi r14, r14, 4
  ret

; ==========================================================================
;  sched_ready_above(r1 = &PCB limite) -> r1 = 1 se esiste un task ESEGUIBILE
;  a un livello strettamente piu' prioritario del limite, 0 altrimenti.
;
;  --- E' LA PRIMA DOMANDA CHE SI PUO' FARE ALLO SCHEDULER SENZA MUOVERLO ---
;
;  `scheduler` sceglie e SFILA: e' un comando, non una domanda, quindi non e'
;  interrogabile -- chiederglielo per sapere costerebbe rimettere dentro cio'
;  che ha tolto. Questa e' la stessa scansione senza l'effetto, ed e' cio' che
;  permette a un chiamante di decidere se valga la pena pagare una commutazione
;  PRIMA di pagarla.
;
;  Il prezzo e' quello gia' dichiarato in tcb.vinc: 12 cicli per livello vuoto,
;  quindi 96 nel caso peggiore (otto livelli). Contro i ~460 di un context
;  switch, e' il motivo per cui la domanda conviene anche quando la risposta e'
;  "si'".
;
;  --- IL LIMITE E' ESCLUSIVO, E CHI CHIAMA SCEGLIE COSA INCLUDERE ---
;  Perche' le due domande utili sono diverse:
;
;    mutex_unlock   "qualcuno mi BATTE adesso che sono sceso dal ceiling?"
;                   -> limite = il proprio PCB. I pari non contano: un unlock
;                      non e' una fine turno.
;    un ceditore    "c'e' qualcuno a cui cedere?"
;                   -> limite = il proprio PCB + PCB.size, cioe' il proprio
;                      livello INCLUSO: cedere a un pari e' lo scopo.
;
;  Un livello e' popolato se ha qualcuno in coda O nello slot: sono i due posti
;  in cui un eseguibile puo' stare, ed e' la stessa coppia che guarda sched_scan.
;
;  --- IL CONTROLLO SULLO SLOT E' OGGI IRRAGGIUNGIBILE, E RESTA ---
;  Verificato per esecuzione (12/09/2026): sull'intera suite le due lw girano lo
;  STESSO numero di volte, cioe' il ramo dello slot non scatta mai. E non e' un
;  caso dei test, e' una proprieta': sp_preempted mette l'uscente nello slot del
;  SUO livello e dispaccia qualcuno piu' prioritario, quindi uno slot occupato
;  sta sempre SOTTO chi gira -- e con i limiti che i due chiamanti usano (il
;  proprio PCB, o il proprio piu' uno) quel ramo e' fuori portata.
;
;  Si tiene lo stesso, e la ragione non e' la prudenza generica: questa routine
;  DEVE rispondere come risponderebbe sched_scan, e sched_scan lo slot lo guarda
;  per primo. Toglierlo renderebbe le due divergenti, e la divergenza reggerebbe
;  su un'invariante che nessuno ha scritto da nessuna parte. Chi un domani
;  chiamasse questa con un limite piu' basso del proprio livello troverebbe una
;  risposta giusta invece di una sbagliata in silenzio.
;
;  ATTENZIONE pero' a cosa vuol dire: e' codice CORRETTO E MAI ESEGUITO. Se
;  qualcuno cambia il modo in cui gli slot si riempiono, qui non c'e' nessun
;  test che se ne accorga.
;
;  Sta nel kernel per la stessa ragione di prio_pcb: l'aritmetica che fa E'
;  l'invariante di §7.3 (tabella dei PCB contigua e in ordine), e farla uscire
;  significherebbe che un secondo modulo la conosce senza garantirla.
;
;  FOGLIA e NON DISTRUTTIVA: non tocca una sola struttura. Clobber: r1, r2, r3.
; ==========================================================================
sched_ready_above:
  li r2, pcb0
sps_scan:
  beq r2, r1, sps_none      ; arrivato al limite senza trovare niente
  lw r3, PCB.preempted(r2)
  bne r3, r0, sps_found
  lw r3, HEAD.count(r2)       ; &pcb == &pcb.coda (§7.5)
  bne r3, r0, sps_found
  addi r2, r2, PCB.size
  j sps_scan
sps_none:
  li r1, 0
  ret
sps_found:
  li r1, 1
  ret

; ==========================================================================
;  prio_pcb(r1 = livello, 0..N_LIVELLI-1) -> r1 = &PCB di quel livello.
;
;  L'UNICO PUNTO IN CUI UNA PRIORITA' E' UN NUMERO. Ovunque altrove e' un
;  INDIRIZZO — TCB.pcb lo contiene, i confronti sono blt sui puntatori (§7.3), e
;  la scansione avanza di PCB.size — ed e' bene che resti cosi': e' quella forma
;  a rendere la selezione O(1) senza nessuna conversione.
;
;  Ma tcb.vinc pubblica anche PRIO_MAX e PRIO_IDLE, cioe' dei numeri, e finora
;  non c'era modo di trasformarli in cio' che il runtime usa: le due costanti
;  comparivano solo dentro i commenti, mentre ogni boot scriveva "li r4, pcb2" a
;  mano. Il primo a inciampare nel buco e' stato il ceiling di un mutex, che per
;  §3.26 dell'handoff si dichiara nominando il task piu' prioritario fra i suoi
;  utenti:
;
;      .equ MTX_POOL_CEILING  PRIO_GESTORE_TIMEOUT
;
;  Un ".equ NOME pcb0" non e' scrivibile — costanti ed etichette sono due spazi
;  di nomi risolti in momenti diversi (§3.27) — quindi il ponte non poteva che
;  essere una procedura.
;
;  STA QUI E NON NEL MUTEX perche' l'aritmetica che fa E' l'invariante di §7.3:
;  la tabella dei PCB e' contigua e in ordine. Quella e' la cosa che la tabella
;  qui sopra dichiara come "da non rompere", e farla uscire dal kernel
;  significherebbe che un secondo modulo la conosce senza essere quello che la
;  garantisce.
;
;  Non e' sul percorso caldo: la si chiama al boot, quando si dichiara la
;  priorita' di un task o il ceiling di un mutex. Foglia. Clobber: r1, r2.
; ==========================================================================
prio_pcb:
  li r2, PCB.size
  mul r1, r1, r2
  li r2, pcb0
  add r1, r2, r1
  ret

; ==========================================================================
;  request_preempt: arma il need_resched. Chiamata dall'handler quando vuole uno
;  switch; un handler che NON la chiama => nessuna preemption (scelta dell'app).
;  Clobber: r1, r2.
; ==========================================================================
request_preempt:
  li r1, g_resched
  li r2, 1
  sw r2, 0(r1)
  ret

; ==========================================================================
;  sched_isr_exit(r1 = contesto opaco del task interrotto): USCITA DA UN'ISR.
;  Ci salta l'ISR applicativa quando ha finito, e non ritorna mai.
;
;  Sostituisce sched_dispatch (§12.2 della proposta). La differenza non e' il
;  nome: sched_dispatch veniva chiamata DALL'HAL e invocava lei l'ISR, mettendo
;  il kernel in mezzo fra il vettore e il codice applicativo. Ora il vettore
;  consegna direttamente all'ISR, e il kernel torna in gioco solo quando l'ISR
;  glielo chiede — che e' cio' che rende l'ISR cliente di HAL e kernel invece
;  che una callback del kernel.
;
;  Registra il contesto uscente nel TCB corrente (l'ISR non tocca il TCB: non e'
;  affar suo dove finisce il contesto), poi, SOLO se l'ISR ha chiesto una
;  preemption, consulta lo scheduler. Chiama SEMPRE il dispatcher: con o senza
;  switch e' l'unico modo di uscire dalla trap.
;
;  Non ha un ritorno proprio (il dispatcher, in coda, chiude nell'HAL con
;  ctx_restore/reti): niente da salvare per se stessa, anche se non-foglia.
;  Non tocca alcun CSR: il kernel resta puro.
; ==========================================================================
sched_isr_exit:
  li r2, current
  lw r3, 0(r2)
  sw r1, TCB.sp(r3)      ; current.sp = contesto uscente (opaco)
  mov r1, r3             ; r1 = TCB per il dispatcher. Il DEFAULT e' l'uscente,
                         ; ed e' la forma esatta di "senza preemption riprende
                         ; chi girava": senza switch nessuno sceglie niente,
                         ; quindi non e' lo scheduler a doverlo dire

  li r2, g_resched
  lw r4, 0(r2)
  beq r4, r0, sched_isr_exit_done
  sw r0, 0(r2)           ; consuma il need_resched

  call sched_preempt     ; POLITICA: mette via l'uscente e sceglie -> r1
sched_isr_exit_done:
  call dispatcher        ; MECCANISMO: mette in esecuzione r1, SEMPRE

; ==========================================================================
;  scheduler (POLITICA, interno) -> r1 = TCB scelto: PRIORITA' STATICHE con PCB
;  (§3, §4). Mette via l'uscente e sceglie il prossimo. Non e' un'API generica
;  (un solo chiamante: sched_isr_exit) -> scritta a mano, non .proc. Non-foglia.
;
;  Dal 07/09/2026 non e' piu' round-robin a coda singola, ed e' il passaggio che
;  la separazione mechanism/policy prometteva: HAL, sched_isr_exit e dispatcher
;  NON sono stati toccati. Cambia solo questa routine e le strutture che legge.
;
;  NON tocca l'uscente, ed e' §2 alla lettera: "dove va l'uscente lo decide chi
;  lo toglie dalla CPU, non chi sceglie il prossimo". Le tre destinazioni sono
;  incompatibili fra loro e le conosce solo chi provoca l'uscita:
;
;    preemptato da un tick  -> PCB.preempted,  lo mette sched_isr_exit
;    si e' bloccato          -> gia' accodato altrove (mailbox, semaforo): NESSUNO
;                               deve toccarlo, ed e' per questo che questa
;                               routine non puo' avere una regola sua
;    turno finito            -> in fondo a PCB.queue (rotazione, non implementata)
;
;  Se lo scheduler mettesse l'uscente nello slot "per default", un task che si
;  blocca tornerebbe eseguibile subito dopo essersi messo in attesa: sarebbe
;  nella coda della mailbox E nello slot del suo livello, cioe' in due posti,
;  con una coppia di link sola (§7.5).
;
;  NON scrive 'current' e NON scrive lo stato del task scelto: RESTITUISCE un
;  TCB, e il commit e' del dispatcher (§12.3). E' la differenza fra applicare una
;  politica e mettere in esecuzione — finche' scriveva 'current' faceva tutte e
;  due, e il confine fra i due algoritmi era una convenzione invece che
;  un'interfaccia. Quello che resta qui e' politica pura: dove va l'uscente
;  (round-robin: in fondo) e chi e' il prossimo.
; ==========================================================================
; ==========================================================================
;  sched_preempt(r1 = TCB uscente) -> r1 = TCB scelto: la POLITICA COMPLETA per
;  un'uscita involontaria. Mette via l'uscente E sceglie, e le due cose non sono
;  separabili perche' DOVE va l'uscente dipende da chi lo sostituisce.
;
;  --- LA DISTINZIONE DI §2, E PERCHE' NON SERVE SAPERE CHI HA CHIAMATO ---
;  §2 dice che un task preemptato va nello slot (riprendera' da dove stava) e uno
;  che ha finito il turno va in fondo alla coda (tocca a un pari). Sembrava
;  servisse un modo di sapere se a far rientrare nel kernel fosse stato il tick o
;  un evento. Non serve: la differenza EMERGE DALLA SCANSIONE.
;
;    la scansione trova qualcuno PRIMA del livello dell'uscente
;        -> esiste un piu' prioritario: era una preemption vera, e l'uscente non
;           ha consumato il suo turno. Slot.
;    la scansione arriva al livello dell'uscente senza trovare nessuno sopra
;        -> l'uscente e' ancora il piu' prioritario, quindi il rientro nel kernel
;           non era per colpa di nessuno: era il tick, cioe' fine turno. Va in
;           fondo alla SUA coda e tocca a un pari -- se non c'e' nessun pari,
;           la coda restituisce lui stesso e nulla cambia.
;
;  E' esattamente SCHED_RR, e senza un quanto: IL TICK E' IL QUANTO, perche' il
;  timer scandisce gia' il tempo e non serve un contatore per misurare cio' che
;  il periodo del timer misura da se'.
;
;  Non-foglia -> salva r15. r7 tiene il PCB corrente perche' dequeue_head sporca
;  r2/r4/r5, r8 il PCB dell'uscente.
; ==========================================================================
sched_preempt:
  addi r14, r14, -4
  sw r15, 0(r14)
  addi r14, r14, -4
  sw r1, 0(r14)          ; l'uscente, che deve sopravvivere alle call
  lw r8, TCB.pcb(r1)     ; r8 = il livello dell'uscente: il confine della corsa

  li r7, pcb0
sp_scan:
  beq r7, r8, sp_mio_livello   ; arrivato al mio livello senza trovare nessuno
  lw r1, PCB.preempted(r7)
  beq r1, r0, sp_tail
  sw r0, PCB.preempted(r7)
  j sp_preempted
sp_tail:
  mov r1, r7
  call dequeue_head
  mov r1, r2
  bne r1, r0, sp_preempted
  addi r7, r7, PCB.size
  j sp_scan

  ; --- trovato uno PIU' PRIORITARIO: l'uscente e' stato preemptato (§2) ---
sp_preempted:
  lw r2, 0(r14)          ; l'uscente
  sw r2, PCB.preempted(r8)
  li r3, PREEMPTED
  sw r3, TCB.state(r2)
  j sp_done

  ; --- nessuno sopra: era FINE TURNO. L'uscente in fondo alla sua coda, e la
  ;     testa della coda e' il prossimo. Se e' solo al suo livello riprende lui,
  ;     e la rotazione degenera nel non fare niente -- che e' corretto.
sp_mio_livello:
  lw r2, 0(r14)
  ; --- CHI E' IN SEZIONE CRITICA NON SI RUOTA (§13.2, §13.5) ---
  ; La preemption e' stretta e non tocca i pari; la rotazione e' l'UNICO
  ; meccanismo che agisce sull'uguale, e al livello di un ceiling l'uguale sono
  ; gli utenti del mutex. Toglierla al possessore e' cio' che rende vera la
  ; premessa di §13.5 ("maggiore O UGUALE esclude che tu stia girando"), che
  ; senza questa riga e' falsa. Il costo e' una lw e una bne su un percorso che
  ; gira solo quando qualcuno ha armato il need_resched.
  ; Lo scheduler non sa cosa sia un mutex: legge un contatore (vedi tcb.vinc).
  lw r3, TCB.crit(r2)
  bne r3, r0, sp_solo
  lw r3, HEAD.count(r8)       ; ci sono PARI in attesa a questo livello?
  beq r3, r0, sp_solo          ; no: ruotare con nessuno e' due call sprecate
  sw r0, TCB.state(r2)         ; READY
  mov r1, r8                   ; &pcb == &pcb.coda
  call enqueue_tail            ; in FONDO: il round-robin e' il FIFO del livello
  mov r1, r8
  call dequeue_head           ; il primo dei pari
  mov r1, r2
  j sp_done
  ; Il caso "solo al mio livello" e' quello NORMALE in un sistema ben
  ; dimensionato, e senza questo ramo costava enqueue + dequeue a ogni tick:
  ; -34% sui contatori del test. Qui l'uscente non si muove e resta RUNNING --
  ; non e' un'ottimizzazione di comodo, e' che ruotare con nessuno non e' una
  ; rotazione: la coda restituirebbe lui stesso dopo averlo accodato.
sp_solo:
  mov r1, r2

sp_done:
  addi r14, r14, 4       ; scarta l'uscente
  lw r15, 0(r14)
  addi r14, r14, 4
  ret

; ==========================================================================
;  scheduler (POLITICA, interno) -> r1 = TCB scelto: la scansione NUDA, per chi
;  non ha un uscente da mettere via -- oggi task_block, il cui chiamante si e'
;  gia' accodato altrove.
; ==========================================================================
scheduler:
  addi r14, r14, -4
  sw r15, 0(r14)         ; non-foglia: preserva il ritorno

  ; --- scansione dall'alto: a ogni livello lo slot batte la coda (§4) ---
  ; Il PCB corrente sta in r7 e NON in uno scratch: dequeue_head sporca r2, r4
  ; e r5 (lo dichiara queue_api.vinc), quindi tenerlo in r5 lo farebbe avanzare
  ; da un indirizzo spazzatura dalla seconda iterazione in poi. E' un bug che
  ; non si vede su un solo livello: lo scan si ferma sempre al primo giro finche'
  ; c'e' un preemptato in cima.
  li r7, pcb0            ; si parte da 0, che e' la priorita' PIU' ALTA
sched_scan:
  lw r1, PCB.preempted(r7)
  beq r1, r0, sched_scan_queue
  sw r0, PCB.preempted(r7)  ; lo slot si svuota: quel task torna a girare
  j sched_scan_done
sched_scan_queue:
  mov r1, r7             ; &pcb == &pcb.coda (§7.5 un livello sopra)
  call dequeue_head     ; r2 = TCB, 0 se il livello e' vuoto
  mov r1, r2
  bne r1, r0, sched_scan_done
  addi r7, r7, PCB.size  ; livello successivo, cioe' meno prioritario
  j sched_scan
sched_scan_done:
  ; La scansione TERMINA SEMPRE e non ha il caso "nessuno eseguibile": l'idle
  ; sta a PRIO_IDLE e non si blocca mai, quindi l'ultimo livello e' pronto per
  ; costruzione (§4). Se un giorno lo fosse, si uscirebbe da qui oltre pcb7 con
  ; r1 = 0 -- ed e' un errore di costruzione del sistema, non un caso da gestire.
  lw r15, 0(r14)
  addi r14, r14, 4
  ret                    ; r1 = TCB scelto

; ==========================================================================
;  dispatcher(r1 = &TCB) (MECCANISMO puro, interno): mette in esecuzione il task
;  che riceve IN INPUT, switch o no — chiama l'HAL (ctx_restore) e non sa ne'
;  vuole sapere come sono fatti i registri. Non ritorna mai (ctx_restore chiude
;  con reti): niente da salvare. Non e' un'API generica (un solo chiamante:
;  sched_isr_exit) -> scritto a mano.
;
;  L'INPUT ESPLICITO e' §12.3, e ha chiuso il debito che stava scritto qui.
;  Prima il TCB passava fra i due algoritmi attraverso 'current': lo scheduler
;  ce l'aveva in un registro, lo scriveva in memoria, e due istruzioni dopo il
;  dispatcher lo rileggeva. Il confine non era un'interfaccia, era una
;  convenzione — e finche' era cosi' il terzo ritorno da un'ISR (§12.4, "salta
;  al dispatcher perche' la scelta e' gia' fatta") non era nemmeno esprimibile:
;  non c'era un posto dove mettere il TCB.
;
;  Ed e' QUI che si scrivono 'current' e lo stato RUNNING, non nella politica:
;  il dispatcher e' l'unico punto da cui un task entra in esecuzione, quindi e'
;  l'unico che possa dichiararlo. Sul percorso senza preemption la scrittura e'
;  idempotente (current gia' puntava li', lo stato era gia' RUNNING) e costa due
;  istruzioni: si paga perche' l'invariante "current lo scrive solo il
;  dispatcher" vale piu' di due istruzioni per tick — e' cio' che rende vero,
;  invece che sperato, che nessun altro possa mettere in esecuzione un task.
; ==========================================================================
dispatcher:
  li r2, current
  sw r1, 0(r2)           ; COMMIT: current = il TCB che sta per girare
  li r3, RUNNING
  sw r3, TCB.state(r1)   ; ... ed e' RUNNING per definizione di dispatcher
  lw r1, TCB.sp(r1)      ; r1 = contesto opaco da riprendere
  call ctx_restore       ; HAL: ripristina i registri e cede il controllo
