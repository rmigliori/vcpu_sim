; rtos/test/test_catena.vasm — LA CATENA A -> B -> C: due salti di mailbox fatti
; da TASK, e il risveglio che non preempta.
;
; E' il primo dei due passi che restano del test di §3.28, ed e' stato separato
; dall'altro (il gestore dei timeout come task) per la stessa ragione per cui
; test_block e' venuto prima di questo: l'altro pezzo tira dentro anche il pool
; (§10), e se qualcosa non torna conviene che tutto il resto sia gia' verificato.
;
; --- COSA C'E' QUI CHE NON C'ERA IN test_block ---
;
; test_block aveva un percorso solo: l'ISR consegna, il task si sveglia. Qui il
; messaggio attraversa tre task e due mailbox, e per farlo passa da codice che
; fino a oggi era scritto e mai eseguito:
;
;   1. send_s, LA SEND DA TASK. In test_block la send la fa l'ISR, con IE gia'
;      a 0, ed e' il caso per cui esiste la raw (§8.5). Qui A e B mandano da
;      contesto di task, con IE=1: e' il wrapper a doverci essere, e la sezione
;      critica non e' una precauzione teorica -- fra il test del contatore e
;      l'accodamento ci puo' arrivare un tick;
;
;   2. IL RAMO DI task_ready CHE NON PREEMPTA. In test_block il risveglio ha
;      sempre vinto (2 batte il 7 dell'idle), quindi la blt sui puntatori ai PCB
;      ha preso sempre lo stesso ramo. Qui A sveglia B, che gli sta SOTTO: il
;      confronto e' falso, non si chiede nessuna preemption, e A continua fino a
;      bloccarsi da solo. E' la preemption DIFFERITA di §6 vista dal lato in cui
;      non succede niente -- il risveglio di un meno prioritario non e' un
;      evento di scheduling, e' solo un enqueue;
;
;   3. LA SCANSIONE CHE ATTRAVERSA LIVELLI POPOLATI. Quando A si blocca, il
;      task_block di §8.8 scandisce pcb0 (vuoto), pcb1 (il SUO livello, e la
;      coda e' vuota perche' A e' andato a stare nella propria mailbox) e trova
;      B in pcb2. In test_block sotto al bloccato c'era solo l'idle.
;
; --- IL PERCORSO, UN GIRO INTERO ---
;
;   tick pari  l'ISR manda a mbA. A e' sospeso li' dentro: consegna diretta,
;              task_ready(A), e 1 batte il 7 dell'idle -> preemption richiesta.
;              All'uscita dall'ISR l'idle va nello slot di pcb7 e parte A
;   A          conta, manda a B (nessuna preemption: 2 non batte 1), torna alla
;              receive, trova mbA vuota e si blocca -> la scansione trova B
;   B          conta, manda a C, si blocca -> la scansione trova C
;   C          conta, si blocca -> la scansione arriva a pcb7 e trova l'idle
;              NELLO SLOT, non in coda: riprende da dove era stato interrotto
;   idle       gira finche' non arriva il tick successivo
;
; --- I VALORI ATTESI ---
;
; cntA, cntB e cntC sono DERIVABILI e devono venire UGUALI FRA LORO: i tick pari
; prima dell'8 sono 2, 4 e 6, quindi tre messaggi entrano nella catena e tre
; devono uscirne. Tenerli separati invece di contare solo l'ultimo non e' zelo:
; se un salto perdesse un messaggio -- una send rifiutata perche' il buffer e'
; ancora in lista (CODA_LINKED) -- i tre numeri direbbero DOVE si e' fermato,
; mentre un contatore solo direbbe soltanto che qualcosa non torna.
;
; cntI dipende dai cicli, e cio' che conta e' che sia > 0: la CPU libera mentre
; tutti e tre i task dormono, che e' la stessa misura di test_block con tre
; dormienti invece di uno.
;
; --- IL PERIODO DEL TIMER, E LA SOGLIA MISURATA ---
;
; 2000 cicli, contro i 500 di test_block, e la ragione e' che la catena COSTA:
; un giro intero sono tre commutazioni volontarie e una preemption, cioe' quattro
; ctx_save/ctx_restore da ~120 cicli l'uno piu' le scansioni. Se il tick torna
; prima che la catena sia drenata, A -- che e' il piu' prioritario -- riparte
; sempre e la CODA della catena non gira mai.
;
; Non e' una supposizione, e' misurato: a 800 cicli questo stesso programma da'
;
;     cntA = 3   cntB = 3   cntC = 0
;
; cioe' i due anelli alti tengono il passo e l'ultimo muore di fame. E' la
; SATURAZIONE di un sistema a priorita' statiche vista in miniatura, e vale la
; pena saperla riconoscere: nessun numero e' "sbagliato", nessuna asserzione
; interna scatta, semplicemente il carico non ci sta nel periodo. Il primo
; periodo che fa passare tutti e tre e' fra 800 e 1000; 2000 lascia il margine
; per cui una modifica al kernel che costi qualche decina di cicli non rende
; rosso un test che parla d'altro.
;
; --- I TRE BUFFER SI RIUSANO, E QUI VA DETTO PERCHE' ---
;
; Un messaggio per salto, riusato a ogni giro. E' lecito perche' i tre task sono
; in serie: quando A manda msgB, il msgB del giro precedente e' gia' stato
; prelevato da B, e dequeue_testa_nc azzera i link del nodo che sfila (§7.5),
; quindi l'invariante fwd == bwd == 0 che la send pretende vale di nuovo. La
; serialita' non e' un'ipotesi sul timing: e' che A non torna a mandare finche'
; non ha ricevuto, e non riceve finche' l'ISR non consegna.

.include "tcb/tcb.vinc"
.include "coda/coda_api.vinc"
.include "mailbox/mailbox.vinc"

  .data

cntA:   .word 0        ; messaggi ricevuti da A (dall'ISR)
cntB:   .word 0        ; ... da B (da A)
cntC:   .word 0        ; ... da C (da B): la fine della catena
cntI:   .word 0        ; giri dell'idle: la CPU libera con tre task che dormono
ticks:  .word 0

; Una mailbox per task, che e' l'ipotesi di §8.1: il contatore con segno arriva
; a -1 e non oltre. Qui ce ne sono tre attive insieme, ognuna con dentro il TCB
; del proprio proprietario, ed e' la prima volta che accade.
mbA:    .res MAILBOX
mbB:    .res MAILBOX
mbC:    .res MAILBOX

msgA:   .space 4       ; due link piu' due parole di payload che nessuno legge
msgB:   .space 4       ; (§8.4): la catena trasporta il fatto che un messaggio
msgC:   .space 4       ; sia arrivato, non un contenuto

tcbA:   .res TCB
tcbB:   .res TCB
tcbC:   .res TCB
tcbI:   .res TCB

stackA: .space 64      ; parole, non byte: 256 byte a testa. La receive di un
stackA_top:            ; task che si blocca tiene sullo stack il proprio frame
stackB: .space 64      ; (12 byte) E il contesto costruito da hal_ctx_block
stackB_top:            ; (CTX_FRAME_SIZE = 64), piu' cio' che serve alla send
stackC: .space 64
stackC_top:
stackI: .space 64
stackI_top:

  .text

  .global main
  .extern current
  .extern pcb1
  .extern pcb2
  .extern pcb3
  .extern pcb7
  .extern sched_init
  .extern send
  .extern send_s
  .extern receive
  .extern irq_install
  .extern sched_isr_exit
  .extern ctx_init
  .extern timer_init
  .extern irq_arm
  .extern irq_enable

; ==========================================================================
;  BOOT. A parte a freddo e si blocca subito; B, C e l'idle nascono READY nelle
;  code dei loro livelli. Nei primi istanti il sistema si svuota da solo -- A si
;  blocca, poi B, poi C -- e resta l'idle: e' la stessa forma di test_block, con
;  la differenza che qui a bloccarsi sono in tre e la scansione deve attraversare
;  tre livelli popolati per arrivare in fondo.
;
;  Il livello 0 resta libero: e' del gestore dei timeout (§9.2), che entra in
;  scena nel secondo passo di §3.28.
; ==========================================================================
main:
  li r14, stackA_top       ; PRIMA di ogni call (sched_init non e' foglia)
  call sched_init

  li r1, mbA
  call coda_init           ; le tre mailbox vuote: count = 0, lista su se stessa
  li r1, mbB
  call coda_init
  li r1, mbC
  call coda_init

  ; --- B (livello 2): READY, in coda ---
  li r1, stackB_top
  li r2, taskB
  call ctx_init
  li r3, tcbB
  sw r1, TCB.sp(r3)
  li r4, pcb2
  sw r4, TCB.pcb(r3)
  sw r0, TCB.state(r3)
  mov r1, r4               ; &pcb == &pcb.coda
  mov r2, r3
  call enqueue_coda

  ; --- C (livello 3): READY, in coda ---
  li r1, stackC_top
  li r2, taskC
  call ctx_init
  li r3, tcbC
  sw r1, TCB.sp(r3)
  li r4, pcb3
  sw r4, TCB.pcb(r3)
  sw r0, TCB.state(r3)
  mov r1, r4
  mov r2, r3
  call enqueue_coda

  ; --- I (idle, livello 7): READY, in coda ---
  li r1, stackI_top
  li r2, taskI
  call ctx_init
  li r3, tcbI
  sw r1, TCB.sp(r3)
  li r4, pcb7
  sw r4, TCB.pcb(r3)
  sw r0, TCB.state(r3)
  mov r1, r4
  mov r2, r3
  call enqueue_coda

  ; --- A (livello 1): parte a freddo, quindi RUNNING e fuori da ogni coda ---
  li r3, tcbA
  li r4, pcb1
  sw r4, TCB.pcb(r3)
  li r1, current
  sw r3, 0(r1)             ; current = A: la sua receive accodera' QUESTO TCB
  li r5, RUNNING
  sw r5, TCB.state(r3)

  li r1, timer_isr
  call irq_install
  call irq_arm
  li r1, 2000              ; QUATTRO VOLTE il periodo di test_block, e non e' un
                           ; numero di comodo: vedi "il periodo del timer" in
                           ; cima. A 800 cicli cntC viene 0, e il test misura la
                           ; saturazione invece della propagazione
  call timer_init
  call irq_enable
  li r5, taskA
  jr r5                    ; cold start di A

; ==========================================================================
;  A (livello 1): riceve dall'ISR e rilancia a B.
;
;  La send_s e' il primo anello, e la sua posizione dice una cosa sola: A manda
;  PRIMA di rimettersi in attesa. Se mandasse dopo essersi bloccato non ci
;  sarebbe catena -- ma soprattutto, mandare da qui significa mandare con IE=1,
;  che e' il caso del wrapper.
; ==========================================================================
taskA:
  li r1, mbA
  call receive             ; r2 = messaggio (o blocco fino alla consegna)
  li r3, cntA
  lw r4, 0(r3)
  addi r4, r4, 1
  sw r4, 0(r3)
  li r1, mbB
  li r2, msgB
  call send_s              ; sveglia B, che sta SOTTO: nessuna preemption
  j taskA

; ==========================================================================
;  B (livello 2): l'anello di mezzo. Identico ad A, e la ripetizione e' il
;  punto: il secondo salto non e' un caso particolare del primo.
; ==========================================================================
taskB:
  li r1, mbB
  call receive
  li r3, cntB
  lw r4, 0(r3)
  addi r4, r4, 1
  sw r4, 0(r3)
  li r1, mbC
  li r2, msgC
  call send_s              ; sveglia C: di nuovo verso il basso
  j taskB

; ==========================================================================
;  C (livello 3): la fine della catena. Conta e basta -- non rilancia, quindi
;  quando si blocca il sistema resta senza niente da fare e scende all'idle.
; ==========================================================================
taskC:
  li r1, mbC
  call receive
  li r3, cntC
  lw r4, 0(r3)
  addi r4, r4, 1
  sw r4, 0(r3)
  j taskC

taskI:
  li r1, cntI
loopI:
  lw r2, 0(r1)
  addi r2, r2, 1
  sw r2, 0(r1)
  j loopI

; ==========================================================================
;  timer_isr(r1 = contesto opaco): innesca la catena ogni due tick.
;
;  Manda solo alla PRIMA mailbox: gli altri due salti li fanno i task. E' la
;  differenza con test_block, dove l'ISR era l'unico mittente del programma.
;
;  Qui la send e' la RAW, e per il motivo di sempre (§8.5): gli interrupt sono
;  gia' disabilitati, e il wrapper aggiungerebbe una irq_save che non serve.
;  Nello stesso programma convivono i due usi, ed e' esattamente il modo in cui
;  la coppia raw/_s va letta -- non due varianti fra cui scegliere, ma due
;  contesti di chiamata diversi.
; ==========================================================================
timer_isr:
  mov r6, r1               ; il contesto: r1 sta per essere sporcato
  li r1, ticks
  lw r2, 0(r1)
  addi r2, r2, 1
  sw r2, 0(r1)

  li r3, 8
  blt r2, r3, isr_manda
  li r1, cntA
  lw r5, 0(r1)
  dumps r5                 ; DERIVABILE: i tick pari prima dell'8 -> 2, 4, 6 = 3
  li r1, cntB
  lw r5, 0(r1)
  dumps r5                 ; UGUALE ad A: il primo salto non ha perso niente
  li r1, cntC
  lw r5, 0(r1)
  dumps r5                 ; UGUALE ai due sopra: la catena e' arrivata in fondo
  li r1, cntI
  lw r5, 0(r1)
  dumps r5                 ; > 0: la CPU libera mentre tutti e tre dormono
  halt

isr_manda:
  li r3, 2
  rem r4, r2, r3
  bne r4, r0, isr_go       ; solo sui tick pari
  li r1, mbA
  li r2, msgA
  call send                ; raw: la consegna sveglia A e chiede la preemption
isr_go:
  mov r1, r6
  j sched_isr_exit
