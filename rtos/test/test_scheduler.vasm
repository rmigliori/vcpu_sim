; rtos/test/test_scheduler.vasm — verifica lo SCHEDULER A PRIORITA' STATICHE
; con PCB (§3, §4 della proposta). Sostituisce rtos/demo/scheduler_demo.vasm,
; ritirato il 07/09/2026.
;
; --- PERCHE' IL VECCHIO E' STATO RITIRATO, E NON ADATTATO ---
; scheduler_demo verificava che due task si ALTERNASSERO a ogni tick, e i suoi
; numeri (98/65) misuravano quello. Con le priorita' quel comportamento non
; esiste piu': l'uscente al tick va nello slot del suo livello e lo slot batte
; la coda (§4), quindi due pari non si alternano -- la rotazione arrivera' con
; la distinzione fra "turno finito" e "preemption vera" (§2), che non e' ancora
; implementata. Un test che sopravvive al modello che verificava e' peggio di
; nessun test: passa, e dice il falso.
;
; --- COSA VERIFICA QUESTO, E COSA NO ---
; E' il PRIMO STRATO del test descritto in §3.28 dell'handoff. Quello completo
; -- idle, due task in cima che si mandano messaggi via timeout, uno sotto che
; li conta -- si regge sul BLOCCO, quindi su task_block, che non esiste ancora
; (§8.8). Qui non si blocca nessuno: tutti e tre i task sono loop infiniti, e le
; sole transizioni sono quelle che il tick provoca.
;
; Tre task e tre proprieta':
;
;   I     livello 7  l'IDLE, e il sistema PARTE con lui solo: e' l'unico
;                    eseguibile fino al 2o tick.
;   M, D  livello 2  PARI fra loro. L'ISR li rende eseguibili al 2o tick.
;   H     livello 1  l'ISR lo rende eseguibile al 4o. Da li' gira sempre lui.
;
; --- PERCHE' L'IDLE DEVE GIRARE ---
; La prima stesura aveva i tre task tutti eseguibili dall'inizio, e dichiarava
; "cntI deve valere esattamente 0" come se fosse la proprieta' piu' forte. Era
; una TAUTOLOGIA: se nessuno si blocca mai e c'e' sempre qualcuno di eseguibile,
; l'idle non gira per costruzione e il suo contatore non misura niente. Ma il
; contatore dell'idle NON e' un controllo di sanita': e' la STATISTICA DI CPU
; LIBERA, cioe' la misura che in un RTOS dice se il sistema regge. Un idle che
; non gira mai e' un idle che non la puo' dare.
; Qui la si ottiene facendo partire il sistema con la sola idle. Nella
; simulazione completa (§3.28) verra' invece dai task che DORMONO, che e' la
; forma vera -- e serve task_block (§8.8).
;
; Tre proprieta':
;   1. PRECEDENZA: ogni volta che entra qualcuno di piu' prioritario, il
;      contatore di chi girava si ferma e parte quello nuovo. Tre fasi disgiunte.
;   2. LO SLOT (§2): chi viene preemptato non finisce in fondo a una coda, sta
;      nello slot del suo livello, identificato. Se lo scheduler lo perdesse o lo
;      riaccodasse male, riprenderebbe: l'osservabile e' che NON riparte.
;   3. LA SCANSIONE RAGGIUNGE IL FONDO: cntI > 0 prova che il livello 7 e'
;      davvero raggiungibile. Con l'idle sempre a zero un errore nell'ultimo
;      livello della scansione non si vedrebbe.
;   4. LA ROTAZIONE FRA PARI: cntD > 0. E' il numero che vale di piu' di tutti,
;      perche' senza rotazione varrebbe ESATTAMENTE ZERO -- M finirebbe nello
;      slot di pcb2 a ogni tick, lo slot batte la coda, e D non uscirebbe mai.
;      Che sia diverso da cntM non e' un difetto: i due turni non sono simmetrici
;      (il primo si porta dietro l'attivazione di entrambi), e cio' che il test
;      asserisce e' che il testimone sia PASSATO, non che le fette siano uguali.
;
; L'ISR fa a mano cio' che fara' task_ready (accoda + chiedi preemption): quel
; simbolo nel kernel non c'e' ancora, ed e' lo stesso debito per cui
; test_mailbox si scrive i propri stub.

.include "tcb/tcb.vinc"
.include "coda/coda_api.vinc"

  .data

cntH:   .word 0        ; contatori applicativi, FUORI dai TCB
cntM:   .word 0
cntI:   .word 0
cntD:   .word 0        ; D e' PARI di M: serve a vedere la rotazione
ticks:  .word 0        ; tick contati dall'ISR

tcbH:   .res TCB
tcbM:   .res TCB
tcbI:   .res TCB
tcbD:   .res TCB

stackH: .space 64
stackH_top:
stackM: .space 64
stackM_top:
stackI: .space 64
stackI_top:
stackD: .space 64
stackD_top:

  .text

  .global main
  .extern current
  .extern pcb1
  .extern pcb2
  .extern pcb7
  .extern sched_init
  .extern irq_install
  .extern request_preempt
  .extern sched_isr_exit
  .extern ctx_init
  .extern timer_init
  .extern irq_arm
  .extern irq_enable

; ==========================================================================
;  BOOT. main non e' un task: non ha TCB e non torna mai.
;
;  Ogni TCB vuole TRE cose prima di essere eseguibile: il contesto iniziale
;  (ctx_init), il PCB del suo livello, e la posizione fisica che corrisponde al
;  suo stato (§5) — in coda se READY, fuori da tutto se RUNNING.
;
;  TCB.pcb e' un INDIRIZZO, non un indice (§7.3): si scrive &pcbN e basta.
;  E l'accodamento passa &pcbN direttamente a enqueue_coda, senza conversione,
;  perche' la TESTA e' annidata a offset 0 nel PCB: &pcb == &pcb.coda.
; ==========================================================================
main:
  li r14, stackI_top       ; PRIMA di ogni call: sched_init non e' foglia e senza
                           ; stack scriverebbe a -4. Puo' usare lo stack dell'idle
                           ; perche' e' il task che main diventera' col cold
                           ; start in fondo -- come nella vecchia demo, dove
                           ; pero' l'unica call di boot (coda_init) era foglia e
                           ; il problema non si vedeva.
  call sched_init          ; le otto code vuote e gli slot liberi

  ; --- H (livello 1) e M (livello 2): pronti ma NON eseguibili. Li attivera'
  ;     l'ISR, M al 2o tick e H al 4o. Il sistema PARTE con la sola idle, ed e'
  ;     questo che rende cntI una misura invece di una tautologia: se nessuno si
  ;     bloccasse mai e ci fosse sempre un task pronto, l'idle non girerebbe per
  ;     costruzione e il suo contatore non direbbe niente.

  ; --- H (livello 1): pronto ma NON eseguibile. Lo attivera' l'ISR al 4o tick,
  ;     ed e' cio' che rende osservabile la preemption invece di doverla
  ;     dedurre da due contatori che crescono insieme.
  li r1, stackH_top
  li r2, taskH
  call ctx_init
  li r3, tcbH
  sw r1, TCB.sp(r3)
  li r4, pcb1
  sw r4, TCB.pcb(r3)
  sw r0, TCB.state(r3)     ; READY, ma in nessuna coda: invisibile allo scheduler

  li r1, stackM_top
  li r2, taskM
  call ctx_init
  li r3, tcbM
  sw r1, TCB.sp(r3)
  li r4, pcb2
  sw r4, TCB.pcb(r3)
  sw r0, TCB.state(r3)     ; READY, ma in nessuna coda

  li r1, stackD_top
  li r2, taskD
  call ctx_init
  li r3, tcbD
  sw r1, TCB.sp(r3)
  li r4, pcb2              ; PARI di M: stesso livello, stessa coda
  sw r4, TCB.pcb(r3)
  sw r0, TCB.state(r3)

  ; --- I (idle, livello 7): parte a freddo, quindi RUNNING e fuori da ogni coda ---
  li r3, tcbI
  li r4, pcb7
  sw r4, TCB.pcb(r3)
  li r1, current
  sw r3, 0(r1)             ; current = idle
  li r5, RUNNING
  sw r5, TCB.state(r3)

  li r1, timer_isr
  call irq_install
  call irq_arm
  li r1, 500
  call timer_init          ; un tick ogni 500 cicli
  call irq_enable          ; r14 e' gia' lo stack dell'idle, armato in cima a main
  li r5, taskI
  jr r5                    ; cold start dell'IDLE: e' l'unico eseguibile

; ==========================================================================
;  I tre task: loop infiniti che incrementano il proprio contatore. Nessuno si
;  blocca e nessuno cede: le uniche transizioni sono quelle decise dal tick.
; ==========================================================================
taskH:
  li r1, cntH
loopH:
  lw r2, 0(r1)
  addi r2, r2, 1
  sw r2, 0(r1)
  j loopH

taskM:
  li r1, cntM
loopM:
  lw r2, 0(r1)
  addi r2, r2, 1
  sw r2, 0(r1)
  j loopM

taskD:
  li r1, cntD
loopD:
  lw r2, 0(r1)
  addi r2, r2, 1
  sw r2, 0(r1)
  j loopD

taskI:
  li r1, cntI
loopI:
  lw r2, 0(r1)
  addi r2, r2, 1
  sw r2, 0(r1)
  j loopI

; ==========================================================================
;  timer_isr(r1 = contesto opaco): ISR applicativa del timer (§12.2).
;  Non ritorna: esce saltando a sched_isr_exit col contesto in r1 (§12.4, caso 2).
;
;  Tre compiti, in ordine di tick:
;    2o  attiva M, 4o attiva H — accoda il TCB nella coda del suo livello. E'
;        quello che fara' task_ready quando esistera' (§8.8); qui e' a mano,
;        come gli stub di test_mailbox.
;    8o  stampa i tre contatori e ferma.
;    ogni tick, chiede comunque la preemption: e' l'ISR a decidere, non il
;    kernel (un handler che non la chiede non provoca nessuno switch).
; ==========================================================================
timer_isr:
  mov r6, r1               ; il contesto: r1 sta per essere sporcato
  li r1, ticks
  lw r2, 0(r1)
  addi r2, r2, 1
  sw r2, 0(r1)

  li r3, 8
  blt r2, r3, isr_check4   ; meno di 8: si continua
  li r1, cntH              ; --- fine: i tre contatori, poi stop ---
  lw r5, 0(r1)
  dumps r5
  li r1, cntM
  lw r5, 0(r1)
  dumps r5
  li r1, cntD
  lw r5, 0(r1)
  dumps r5                 ; ~ cntM: M e D sono pari e hanno RUOTATO
  li r1, cntI
  lw r5, 0(r1)
  dumps r5                 ; > 0: la CPU libera dei primi due tick
  halt

isr_check4:
  li r3, 2
  bne r2, r3, isr_check_h  ; al SECONDO tick entra M
  li r1, pcb2              ; &pcb2 == &pcb2.coda
  li r2, tcbM
  call enqueue_coda
  li r1, pcb2              ; ... e D, suo PARI: da qui devono RUOTARE
  li r2, tcbD
  call enqueue_coda
  j isr_go
isr_check_h:
  li r3, 4
  bne r2, r3, isr_go       ; al QUARTO entra H, che batte M
  li r1, pcb1
  li r2, tcbH
  call enqueue_coda        ; H diventa visibile allo scheduler
isr_go:
  call request_preempt     ; arma il need_resched
  mov r1, r6               ; il kernel vuole il contesto in r1
  j sched_isr_exit         ; §12.4 caso 2: rifai la scelta
