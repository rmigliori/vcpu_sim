; m_banco -- come m_attivazione_v (T vettoriale), ma con lib_hal_banco: la via
; veloce. T parte nel banco alternativo e non tiene niente attraverso la wait:
; lo stato del giro sta in memoria. L'idle ha registri vivi e usa i float.
; Stampa L = (t - 5) - D per otto sveglie, come m_attivazione.
.include "tcb/tcb.vinc"
.include "queue/queue_api.vinc"
.include "wait/wait.vinc"
.include "hal/hal.vinc"
.include "hal/clock.vinc"

.equ PASSO 3000

  .data
wT:      .res WAIT
lat:     .space 64
k:       .word 0
base:    .word 0
dl:      .word 0
  .supertask tcbT
tcbI:    .res TCB
stackT:  .space 4096
stackT_top:
stackI:  .space 4096
stackI_top:

  .text
  .global main
  .extern current
  .extern pcb7
  .extern sched_init
  .extern wait_init
  .extern wait
  .extern wait_signal
  .extern sched_isr_exit_to
  .extern irq_install
  .extern irq_arm_banco
  .extern ctx_init

main:
  li r14, stackT_top
  call sched_init
  li r1, wT
  li r2, tcbT
  call wait_init
  li r1, stackI_top
  li r2, taskI
  call ctx_init
  li r3, tcbI
  sw r1, TCB.sp(r3)
  li r4, pcb7
  sw r4, TCB.pcb(r3)
  sw r0, TCB.state(r3)
  mov r1, r4
  mov r2, r3
  call enqueue_tail
  li r3, tcbT
  li r1, current
  sw r3, 0(r1)
  li r5, RUNNING
  sw r5, TCB.state(r3)
  li r1, isr
  call irq_install
  li r1, CAUSE_CMP0
  call irq_arm_banco
  li r1, CLOCK_CYCLES
  lw r2, 0(r1)
  addi r2, r2, PASSO
  li r1, base
  sw r2, 0(r1)
  li r1, PSW_IE_BANK
  mtpsw r1                 ; T parte nel banco alternativo
  li r5, taskT
  jr r5

taskT:
giro:
  li r1, base
  lw r2, 0(r1)
  li r1, k
  lw r3, 0(r1)
  add r2, r2, r3           ; D = base + k
  li r1, dl
  sw r2, 0(r1)
  li r1, CMP0
  sw r2, 0(r1)
  li r1, CMP_CTRL
  li r2, CMP_ARM0_CYC
  sw r2, 0(r1)
  li r1, 64
  setvl r1, r1
  vsplat v0, f0            ; T e' vettoriale
  li r1, wT
  call wait
  .global dopo_wait
dopo_wait:
  li r1, CLOCK_CYCLES
  lw r2, 0(r1)
  li r1, dl
  lw r3, 0(r1)
  sub r2, r2, r3
  addi r2, r2, -5          ; la li e la lw prima della lettura
  li r1, k
  lw r3, 0(r1)
  slli r4, r3, 2
  li r5, lat
  add r5, r5, r4
  sw r2, 0(r5)
  addi r3, r3, 1
  sw r3, 0(r1)
  li r1, base
  lw r4, 0(r1)
  addi r4, r4, PASSO
  sw r4, 0(r1)
  li r1, 8
  bne r3, r1, giro

  li r6, lat
  li r7, 0
stampa:
  lw r5, 0(r6)
  dumps r5
  addi r6, r6, 4
  addi r7, r7, 1
  li r1, 8
  bne r7, r1, stampa
  halt

  .global taskI
taskI:
  li r2, 2
  li r3, 3
  li r4, 4
  fli f1, 1.5
loopI:
  addi r2, r2, 1
  lw r5, 0(r14)
  j loopI

  .interrupt isr
  li r4, CMP_CTRL
  sw r0, 0(r4)
  li r1, wT
  call wait_signal
  .endinterrupt isr r1
