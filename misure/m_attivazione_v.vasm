; m_attivazione_v -- come m_attivazione, ma T e' VETTORIALE (VDIRTY).
; m_attivazione -- comparatore (sui cicli) -> prima istruzione di T dopo wait.
; Otto sveglie, la scadenza spostata di 0..7 cicli: la fase dell'idle cambia.
; Stampa, per ognuna, L = (t - 4) - D: dalla scadenza nominale all'inizio della
; prima istruzione utile di T. L'ISR e' quella di test_wait: disarma e segnala.
.include "tcb/tcb.vinc"
.include "queue/queue_api.vinc"
.include "wait/wait.vinc"
.include "hal/hal.vinc"
.include "hal/clock.vinc"

.equ PASSO 3000

  .data
wT:      .res WAIT
lat:     .space 64
  .supertask tcbT
tcbI:    .res TCB
stackT:  .space 4096
stackT_top:
stackI:  .space 64
stackI_top:

  .text
  .global main
  .extern current
  .extern pcb7
  .extern sched_init
  .extern wait_init
  .extern wait
  .extern wait_signal
  .extern sched_isr_exit_to
  .extern irq_install
  .extern irq_arm
  .extern irq_enable
  .extern ctx_init

main:
  li r14, stackT_top
  call sched_init
  li r1, wT
  li r2, tcbT
  call wait_init

  li r1, stackI_top
  li r2, taskI
  call ctx_init
  li r3, tcbI
  sw r1, TCB.sp(r3)
  li r4, pcb7
  sw r4, TCB.pcb(r3)
  sw r0, TCB.state(r3)
  mov r1, r4
  mov r2, r3
  call enqueue_tail

  li r3, tcbT
  li r1, current
  sw r3, 0(r1)
  li r5, RUNNING
  sw r5, TCB.state(r3)

  li r1, isr
  call irq_install
  call irq_arm
  call irq_enable
  li r5, taskT
  jr r5

taskT:
  li r10, 0                ; k
  li r11, lat
  li r1, CLOCK_CYCLES
  lw r12, 0(r1)
  addi r12, r12, PASSO     ; D0
giro:
  add r13, r12, r10        ; D = base + k
  li r1, CMP0
  sw r13, 0(r1)
  li r1, CMP_CTRL
  li r2, CMP_ARM0_CYC
  sw r2, 0(r1)
  li r1, 64
  setvl r1, r1
  vsplat v0, f0            ; T ha toccato l'unita' vettoriale: VDIRTY
  li r1, CLOCK_CYCLES
  lw r9, 0(r1)
  li r1, wT
  call wait
  .global dopo_wait
dopo_wait:
  li r1, CLOCK_CYCLES      ; 1 ciclo: compensato sotto
  lw r2, 0(r1)
  sub r2, r2, r13
  addi r2, r2, -5          ; la li e la lw
  sw r2, 0(r11)
  addi r11, r11, 4
  addi r12, r12, PASSO
  addi r10, r10, 1
  li r3, 8
  bne r10, r3, giro

  li r11, lat
  li r10, 0
stampa:
  lw r5, 0(r11)
  dumps r5
  addi r11, r11, 4
  addi r10, r10, 1
  li r3, 8
  bne r10, r3, stampa
  halt

  .global taskI
taskI:
  li r1, 0
loopI:
  addi r1, r1, 1
  lw r2, 0(r14)
  j loopI

  .interrupt isr
  li r4, CMP_CTRL
  sw r0, 0(r4)             ; disarma
  li r1, wT
  call wait_signal
  .endinterrupt isr r1
